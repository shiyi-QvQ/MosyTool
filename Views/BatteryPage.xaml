<Page x:Class="Mosytool.Views.BatteryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Mosytool.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="电池健康">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource Mt.PagePadding}">
                <TextBlock Style="{StaticResource Mt.PageTitle}" Text="电池健康" />
                <TextBlock Style="{StaticResource Mt.PageSubtitle}"
                           Text="多节点读取电池管理芯片数据（power_supply / bms / qcom-battery / dumpsys）：健康度优先取芯片直接上报的 SOH，取不到才用「实测满电容量 ÷ 出厂设计容量」推算，不做算法估算。" />

                <!-- ============ 设备与读取 ============ -->
                <Border x:Name="DeviceCard" Style="{StaticResource Mt.Card}" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="BatteryCharge24" />
                            <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="设备" />
                            <Border x:Name="StateDot" Style="{StaticResource Mt.StatusDot}" Margin="14,0,0,0" />
                            <TextBlock x:Name="StateText" Style="{StaticResource Mt.Label}" Text="未检测" Margin="7,0,0,0" />
                            <Border Style="{StaticResource Mt.Divider}" Width="1" Height="14" Margin="14,0" />
                            <TextBlock x:Name="DeviceText" Style="{StaticResource Mt.BodyMuted}"
                                       Text="-" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="RootCheck" Content="用 root 读取" Margin="0,0,14,0"
                                      FontSize="13" ToolTip="部分机型把容量节点限制为 root 可读，勾选后会先 su 再读" />
                            <ui:Button x:Name="ReadButton" Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="读取电池数据" Click="ReadButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 健康度（主视觉） ============ -->
                <Border x:Name="HealthCard" Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 环：健康度百分比，数值由 Anim.To 推上去 -->
                        <StackPanel VerticalAlignment="Center" Margin="4,0,10,0">
                            <Grid Width="136" Height="136">
                                <ui:ProgressRing x:Name="HealthRing" Progress="0" Width="136" Height="136" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="HealthValue" Text="--" FontSize="30" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="HealthCaption" Text="健康度" FontSize="11.5"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Mt.Divider}" Width="1" Height="Auto"
                                Margin="26,6" HorizontalAlignment="Center" />

                        <!-- 六项关键指标：容量 / 循环 / 电压 / 温度 / 电流 / 电量 -->
                        <UniformGrid Grid.Column="2" Columns="3" Rows="2" VerticalAlignment="Center">
                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="设计容量" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="DesignValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="实测满电容量" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="FullValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="循环次数" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="CycleValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="电压" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="VoltageValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="温度" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="TempValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="当前电流" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="CurrentValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- ============ 容量对比 ============ -->
                <Border x:Name="CapacityCard" Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="List24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="容量对比" />
                            </StackPanel>
                            <TextBlock x:Name="CapacityHint" Grid.Column="1" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="设计容量 100% 为基准" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="出厂设计容量" Style="{StaticResource Mt.Label}" />
                            <TextBlock x:Name="DesignBarText" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--" />
                        </Grid>
                        <ProgressBar x:Name="DesignBar" Style="{StaticResource Mt.Meter}" Margin="0,10,0,0" />

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="当前实测容量" Style="{StaticResource Mt.Label}" />
                            <TextBlock x:Name="FullBarText" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--" />
                        </Grid>
                        <ProgressBar x:Name="FullBar" Style="{StaticResource Mt.Meter}" Margin="0,10,0,0" />

                        <TextBlock x:Name="CapacityNote" Style="{StaticResource Mt.Caption}" Margin="0,14,0,0"
                                   Text="实测容量低于设计容量即为正常老化。差值越大，满电续航越短。" />
                    </StackPanel>
                </Border>

                <!-- ============ 电池寿命 ============ -->
                <Border x:Name="LifeCard" Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="ShieldCheckmark24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="电池寿命" />
                            </StackPanel>
                            <TextBlock x:Name="LifeHint" Grid.Column="1" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="按 800 次循环 / 80% 容量标定" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="剩余寿命（估算）" Style="{StaticResource Mt.Label}" />
                            <TextBlock x:Name="LifeText" Style="{StaticResource Mt.Metric}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--" />
                        </Grid>
                        <ProgressBar x:Name="LifeBar" Style="{StaticResource Mt.Meter}" Margin="0,10,0,0" />

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="当前电量" Style="{StaticResource Mt.Label}" />
                            <TextBlock x:Name="LevelText" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="--" />
                        </Grid>
                        <ProgressBar x:Name="LevelBar" Style="{StaticResource Mt.Meter}" Margin="0,10,0,0" />

                        <TextBlock x:Name="LifeNote" Style="{StaticResource Mt.Caption}" Margin="0,14,0,0"
                                   Text="剩余寿命由循环次数换算（无循环数据时按容量衰减到 80% 折算），只是寿命参考，不影响健康度判定。" />
                    </StackPanel>
                </Border>

                <!-- ============ 电池信息（多节点采集） ============ -->
                <Border x:Name="InfoCard" Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="Info24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="电池信息" />
                            </StackPanel>
                            <TextBlock x:Name="NodeHint" Grid.Column="1" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="-" />
                        </Grid>

                        <UniformGrid Columns="3" Rows="3" Margin="0,16,0,0">
                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="电源类型" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="PowerSourceValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="充电功率" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="PowerValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="充电限流" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="LimitValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="充满还需" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="FullTimeValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="放空还需" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="EmptyTimeValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="电压区间" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="VoltageRangeValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="电池厂商" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="MakerValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="电池序列号" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="SerialValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Mt.Inset}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="能量标称" Style="{StaticResource Mt.Caption}" />
                                    <TextBlock x:Name="EnergyValue" Text="--" Style="{StaticResource Mt.Metric}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock x:Name="HealthSourceNote" Style="{StaticResource Mt.Caption}" Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Text="健康度优先取电池芯片直接上报的 SOH，取不到才用「实测满电容量 ÷ 设计容量」推算。" />
                    </StackPanel>
                </Border>

                <!-- ============ 结论 ============ -->
                <Border x:Name="VerdictCard" Style="{StaticResource Mt.Card.Accent}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="ShieldCheckmark24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="评估结论" />
                                <Border x:Name="VerdictPill" Style="{StaticResource Mt.Pill}" Margin="12,0,0,0">
                                    <TextBlock x:Name="VerdictPillText" Text="等待数据" Style="{StaticResource Mt.Pill.Text}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="VerdictText" Style="{StaticResource Mt.BodyMuted}" Margin="0,12,0,0"
                                       TextWrapping="Wrap" Text="连接设备后点「读取电池数据」。" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock x:Name="TechText" Style="{StaticResource Mt.Caption}"
                                       HorizontalAlignment="Right" Text="-" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Mt.Caption}" Margin="0,6,0,0"
                                       HorizontalAlignment="Right" Text="-" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 原始数据 ============ -->
                <Expander x:Name="RawExpander" Margin="0,14,0,0" IsExpanded="False"
                          Header="原始 sysfs 数据（可核对每一项来源）">
                    <Border Style="{StaticResource Mt.Inset}" Margin="0,10,0,0">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="RawText" Style="{StaticResource Mt.Mono}"
                                       Text="尚未读取" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- ============ 日志 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="BookOpen24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="操作日志" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="清空" Click="ClearLog_Click" />
                        </Grid>

                        <ctl:LogView x:Name="LogBox" Height="170" Margin="0,16,0,0"
                                     FontFamily="Consolas" FontSize="12"
                                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                                     BorderThickness="0" Padding="12"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
