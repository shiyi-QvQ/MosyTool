<Page x:Class="Mosytool.Views.PayloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Payload 解包">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="Payload 解包" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="解析 OTA payload.bin 并提取分区镜像" FontSize="14" Margin="0,6,0,28"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- ============ 选择 payload 文件 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="payload 文件" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PayloadPathBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowsePayload_Click"/>
                            <ui:Button Grid.Column="2" Appearance="Primary" Margin="12,0,0,0"
                                       Content="解析" Click="ParseButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 分区列表 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="分区列表" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="PartitionSummary" Text="尚未解析" FontSize="12" Margin="0,8,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ListBox x:Name="PartitionList" Height="240"
                                 HorizontalContentAlignment="Stretch"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="4"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Display}" FontSize="13"
                                                   FontFamily="Consolas" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Secondary" Content="全选" Click="SelectAll_Click"/>
                            <ui:Button Appearance="Secondary" Content="全不选" Margin="12,0,0,0" Click="SelectNone_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 解包操作 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="解包" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="选择目录…" Click="BrowseOutput_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <ui:Button x:Name="ExtractAllButton" Appearance="Primary" IsEnabled="False"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Content="全部解包" Click="ExtractAll_Click"/>
                            <ui:Button x:Name="ExtractSelectedButton" Appearance="Secondary" IsEnabled="False" Margin="12,0,0,0"
                                       Content="解包选中" Click="ExtractSelected_Click"/>
                        </StackPanel>

                        <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,20,0,8" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ProgressText" Text="等待操作…" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ============ 日志 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookOpen24" FontSize="18" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="解包日志" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="清空" Click="ClearLog_Click"/>
                        </Grid>
                        <TextBox x:Name="LogBox" IsReadOnly="True" Height="200" Margin="0,16,0,0"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="等待操作…"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
