<Page x:Class="Mosytool.Views.FeedbackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="意见反馈">

    <Page.Resources>
        <DataTemplate x:Key="ReplyRowTemplate">
            <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="8"
                    Background="{Binding Background}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding Time}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" FontSize="12.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="意见反馈" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="提交问题、建议或资源反馈；填了邮箱会收到带查询链接的受理邮件"
                       FontSize="14" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左：提交反馈 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="提交新反馈" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="问题分类" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="CategoryCombo" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Text"/>

                        <TextBlock x:Name="ContentLabel" Text="反馈内容" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox x:Name="ContentBox" AcceptsReturn="True" Height="150"
                                    MaxLength="1000" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" Padding="10,8"
                                    PlaceholderText="请把问题描述清楚：机型、操作步骤、期望结果与实际结果"
                                    TextChanged="ContentBox_TextChanged"/>

                        <TextBlock Text="联系邮箱（选填，用于接收查询链接）" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox x:Name="EmailBox" PlaceholderText="you@example.com"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="联系方式" FontSize="12" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="ContactTypeCombo" HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Text"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="账号 / 号码" FontSize="12" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="ContactBox" PlaceholderText="选填"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="SubmitStatusText" Text="" FontSize="12" Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ui:Button x:Name="SubmitButton" Appearance="Primary" Content="提交反馈"
                                   HorizontalAlignment="Left" Margin="0,16,0,0"
                                   Icon="{ui:SymbolIcon Send24}" Click="Submit_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ 右：我的工单 ============ -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="我的工单" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:Button Grid.Column="1" Appearance="Primary" Content="查询进度"
                                   Click="Query_Click"/>
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="移除"
                                   Margin="8,0,0,0" Click="Remove_Click"/>
                    </Grid>

                    <ListBox x:Name="TicketList" Grid.Row="1" Height="110" Margin="0,12,0,0"
                             DisplayMemberPath="DisplayText"
                             SelectionChanged="TicketList_SelectionChanged"/>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="查询令牌（邮件里的 token）" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox x:Name="TokenBox" PlaceholderText="选填"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="或邮箱" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox x:Name="QueryEmailBox" PlaceholderText="选填"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="DetailHeader" Visibility="Collapsed" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="DetailTitle" Text="" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="DetailMeta" Text="" FontSize="11.5" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="DetailEmptyText" Text="从上面选一条工单，或填写凭证后点「查询进度」。"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                            <ItemsControl x:Name="ReplyList"
                                          ItemTemplate="{StaticResource ReplyRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <ui:TextBox x:Name="ReplyBox" AcceptsReturn="True" Height="64"
                                    MaxLength="1000" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" Padding="8,6"
                                    PlaceholderText="补充说明（至少 2 个字）"/>
                        <ui:Button x:Name="ReplyButton" Appearance="Primary" Content="发送补充说明"
                                   HorizontalAlignment="Right" Margin="0,8,0,0"
                                   IsEnabled="False" Click="Reply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
