<Page x:Class="Mosytool.Views.DriverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="端口驱动转换">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 端口行：状态圆点。颜色只表达状态，绿色=工具能直接读写这端口。 -->
        <Style x:Key="PortDot" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource Mt.Status.WarnBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource Mt.Status.OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource Mt.Status.ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 端口的操作按钮：三种尺寸一致，避免同一行里高度参差 -->
        <Style x:Key="PortAction" TargetType="{x:Type ui:Button}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource Mt.PagePadding}">

                <TextBlock Text="端口驱动转换" Style="{StaticResource Mt.PageTitle}" />
                <TextBlock Style="{StaticResource Mt.PageSubtitle}"
                           Text="看每个 USB 端口挂在什么驱动上。9008 / MTK 这类端口需要 WinUSB 这种允许程序直接读写的驱动，本工具的刷写功能才能连上设备。" />

                <!-- ============ 概览 + 工具栏 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="UsbPlug24" Style="{StaticResource Mt.SectionIcon}" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Mt.SectionTitle}"
                                       Text="正在读取端口…" />
                        </StackPanel>

                        <TextBlock x:Name="DriverDirText" Style="{StaticResource Mt.Caption}"
                                   Margin="24,8,0,0" Text="驱动目录" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button x:Name="RefreshButton" Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="刷新端口" Click="Refresh_Click" />
                            <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Content="扫描硬件改动" Click="Scan_Click" />
                            <ui:Button x:Name="LoadInfButton" Appearance="Secondary" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Content="装载本地驱动" Click="LoadLocalInfs_Click" />
                            <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="打开驱动目录" Click="OpenDriverDir_Click" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Mt.Caption}" Margin="0,12,0,0"
                                   Text="装驱动、卸载设备都会改系统设置，点按钮时会弹一次管理员授权（UAC），点「否」则什么都不会发生。" />
                    </StackPanel>
                </Border>

                <!-- ============ 端口列表 ============ -->
                <Border Style="{StaticResource Mt.Card.Flush}" Margin="0,16,0,0">
                    <Grid>
                        <ItemsControl x:Name="PortList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="20,14,20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource PortDot}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource Mt.Body}"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="320"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Border Style="{StaticResource Mt.Pill.Accent}" Margin="8,0,0,0"
                                                        Visibility="{Binding NeedsWinUsb, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource Mt.Pill.Text}"
                                                               Text="建议换驱动"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Summary}"
                                                       Style="{StaticResource Mt.Mono}"
                                                       Margin="0,4,0,0" />

                                            <TextBlock Text="{Binding Hint}" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}"
                                                           BasedOn="{StaticResource Mt.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Hint}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource PortAction}"
                                                       Appearance="Primary"
                                                       Icon="{ui:SymbolIcon UsbPlug24}"
                                                       Content="切换为 WinUSB"
                                                       Click="SwitchWinUsb_Click"
                                                       Visibility="{Binding NeedsWinUsb, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button Style="{StaticResource PortAction}"
                                                       Icon="{ui:SymbolIcon Power24}"
                                                       Content="{Binding ToggleText}"
                                                       Click="DisableEnable_Click" />
                                            <ui:Button Style="{StaticResource PortAction}"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Content="卸载"
                                                       Click="RemoveDevice_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText" Style="{StaticResource Mt.BodyMuted}"
                                   Margin="20,28,20,28" HorizontalAlignment="Center"
                                   Visibility="Collapsed"
                                   Text="没有发现 USB 端口。插上设备后点「刷新端口」，或用「扫描硬件改动」让系统重新识别。" />
                    </Grid>
                </Border>

                <!-- ============ 说明 ============ -->
                <Border Style="{StaticResource Mt.Inset}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Mt.BodyMuted}"
                                       Text="什么时候需要换驱动：设备管理器里端口带黄色感叹号，或者工具提示「打开设备失败」。" />
                            <TextBlock Style="{StaticResource Mt.Caption}" Margin="0,6,0,0"
                                       Text="切到 WinUSB 后设备会重新枚举一次；若列表里驱动已经显示为 WinUSB，就不用再切。装乱了可以「卸载」设备节点再拔插数据线重来。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
