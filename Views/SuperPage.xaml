<Page x:Class="Mosytool.Views.SuperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="super 工具">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="super 工具" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="动态分区合包 / 解析 / 提取，super 内分区刷入指定分区，关闭 AVB 校验"
                           FontSize="14" Margin="0,6,0,28"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- ============ 1. super 合包 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="super 合包（多分区 → super.img）" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="按 liblp 格式把 system / vendor / product 等逻辑分区镜像打包成一个 super.img。支持 raw 与 sparse 源镜像。"
                                   FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Secondary" Content="添加镜像…" Click="AddBuildImages_Click"/>
                            <ui:Button Appearance="Secondary" Content="移除选中" Margin="12,0,0,0" Click="RemoveBuildImage_Click"/>
                            <ui:Button Appearance="Secondary" Content="清空" Margin="12,0,0,0" Click="ClearBuildImages_Click"/>
                        </StackPanel>

                        <ListBox x:Name="BuildList" Height="150" Margin="0,12,0,0"
                                 SelectionMode="Extended"
                                 HorizontalContentAlignment="Stretch"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="4"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontSize="13"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出文件" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="BuildOutputBox" Grid.Column="1" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="2" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="另存为…" Click="BrowseBuildOutput_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模板 super（可选）" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="TemplateBox" Grid.Column="1" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="2" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseTemplate_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="总大小 MB（可选）" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="DeviceSizeBox" Grid.Column="1" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     ToolTip="留空时：有模板则用模板大小，否则按内容自适应"/>
                            <ui:Button x:Name="BuildButton" Grid.Column="2" Appearance="Primary" Margin="12,0,0,0"
                                       Icon="{ui:SymbolIcon BoxMultiple24}" Content="开始合包" Click="Build_Click"/>
                            <TextBlock x:Name="BuildHint" Grid.Column="3" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 2. super 解析 / 提取 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="super 解析与提取" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SuperPathBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseSuper_Click"/>
                            <ui:Button Grid.Column="2" Appearance="Primary" Margin="12,0,0,0"
                                       Content="解析" Click="ParseSuper_Click"/>
                        </Grid>

                        <TextBlock x:Name="SuperSummary" Text="尚未解析" FontSize="12" Margin="0,10,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ListBox x:Name="PartitionList" Height="180"
                                 HorizontalContentAlignment="Stretch"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="4"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Display}" FontSize="13"
                                                   FontFamily="Consolas" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Secondary" Content="全选" Click="SelectAllParts_Click"/>
                            <ui:Button Appearance="Secondary" Content="全不选" Margin="12,0,0,0" Click="SelectNoneParts_Click"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtractDirBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="输出目录…" Click="BrowseExtractDir_Click"/>
                            <ui:Button x:Name="ExtractButton" Grid.Column="2" Appearance="Primary" Margin="12,0,0,0"
                                       IsEnabled="False" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Content="提取选中" Click="Extract_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 3. super 分区刷入指定分区 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="super 内分区刷入指定分区" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="从已解析的 super 中取出某个逻辑分区，再通过 fastboot 写入设备上指定的分区名（如 system_a / vendor / product）。"
                                   FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="super 内分区" FontSize="12" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="SourcePartitionCombo" FontSize="13" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标分区（设备）" FontSize="12" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="TargetPartitionCombo" FontSize="13" IsEditable="True"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button Appearance="Secondary" Content="刷新设备分区" Click="RefreshDevicePartitions_Click"/>
                            <ui:Button x:Name="FlashPartButton" Appearance="Primary" Margin="12,0,0,0"
                                       Icon="{ui:SymbolIcon Flash24}" Content="提取并刷入" Click="FlashPartition_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 4. 关闭 AVB 校验 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="关闭 AVB 校验" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="把 vbmeta 的 flags 置为「关闭 verity + 关闭 verification」，或生成一个未签名的最小 vbmeta，再刷入设备。"
                                   FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VbmetaPathBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseVbmeta_Click"/>
                            <ui:Button Grid.Column="2" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="生成空白 vbmeta" Click="GenerateVbmeta_Click"/>
                        </Grid>

                        <TextBlock x:Name="VbmetaInfoText" Text="尚未加载 vbmeta" FontSize="12" Margin="0,10,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="PatchVbmetaButton" Appearance="Primary" Content="关闭校验（改 flags）"
                                       Click="PatchVbmeta_Click"/>
                            <ui:Button Appearance="Secondary" Content="恢复校验" Margin="12,0,0,0" Click="RestoreVbmeta_Click"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="刷入分区" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="VbmetaPartitionCombo" Grid.Column="1" FontSize="13" IsEditable="True"/>
                            <ui:Button x:Name="FlashVbmetaButton" Grid.Column="2" Appearance="Primary" Margin="12,0,0,0"
                                       Icon="{ui:SymbolIcon Flash24}" Content="刷入 vbmeta" Click="FlashVbmeta_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 日志 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookOpen24" FontSize="18" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="日志" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="清空" Click="ClearLog_Click"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,8" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ProgressText" Text="等待操作…" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" Height="200"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="等待操作…"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
