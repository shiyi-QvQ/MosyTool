<Page x:Class="Mosytool.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:api="clr-namespace:Mosytool.Services.Api"
      ScrollViewer.CanContentScroll="False"
      Title="关于">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="1600">
            <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="关于 MosyTool" FontSize="14" Margin="0,6,0,28"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- 双列铺满宽度，右半边不再空着 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左列：简介 / 初衷 / 技术栈 / 作者 ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="12"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Fluent24" FontSize="28"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,2,0,0" VerticalAlignment="Top">
                            <TextBlock Text="MosyTool" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="手机刷机辅助工具" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <!-- 版本号同时是「维护入口」：连点 5 下才展开下面的服务器设置卡片。
                                 不给 Cursor/下划线，普通用户看不出这里能点。 -->
                            <TextBlock x:Name="AboutVersion" Text="版本 1.0.0" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       MouseLeftButtonDown="AboutVersion_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="官方网站" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="AboutUrl" Text="{x:Static api:ApiClient.DefaultBaseUrl}"
                               FontSize="13" Cursor="Hand" TextWrapping="Wrap"
                               ToolTip="点击打开官方网站"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               MouseLeftButtonDown="AboutUrl_MouseLeftButtonDown"/>
                </StackPanel>
            </Border>

            <!-- ============ 项目初衷 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Flag24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="项目初衷" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="这个项目的想法很简单：把 MYWL 与「我刷机工具箱」想做的事情做完。"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="刷机这件事向来门槛不低，工具零散、文档分散、踩坑全靠口口相传。我们希望能做出一个顺手、干净、靠得住的工具箱，让想折腾的人少走一点弯路——也算为刷机生态圈贡献一份自己的力量。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============ 软件开发的技术栈 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Code24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="软件开发的技术栈" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="界面层" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="WPF (.NET 10) + WPF-UI 4.x（Fluent Design 风格控件与主题）"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="业务层" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="C# / .NET 10，服务化封装 ADB、Fastboot、EDL、MTK 等各条刷机链路"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="原生层" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Rust 编写的 Penumbra（MTK）与 Qualcomm FFI，通过 P/Invoke 直接调用，免去子进程与文本解析"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="依赖与分发" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="SharpCompress、System.Management；Release 采用 win-x64 自包含单文件发布，免装 .NET 运行时"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 项目作者 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="People24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="项目作者" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 作者一：十一SHIYI（主架构设计 / 主开发） -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border x:Name="AvatarShiyi" Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top">
                            <TextBlock x:Name="AvatarShiyiFallback" Text="十" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="十一SHIYI" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="主架构设计 · 主开发" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="QQ 228326485" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 作者二：MYWL（末影） -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border x:Name="AvatarMywl" Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top">
                            <TextBlock x:Name="AvatarMywlFallback" Text="末" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MYWL（末影）" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="项目发起 · 共同开发" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="QQ 2712051569" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

                </StackPanel>

                <!-- ===== 右列：主题色 / 开源许可 / 特别感谢 / 致谢 ===== -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">

            <!-- ============ 主题色 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="主题色" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="选择你喜欢的强调色，应用于按钮、图标和高亮。"
                               FontSize="13" Margin="0,8,0,16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FF3B91D8" Cursor="Hand" Tag="#FF3B91D8" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FFAD6ECA" Cursor="Hand" Tag="#FFAD6ECA" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FF2983CC" Cursor="Hand" Tag="#FF2983CC" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FF6BD490" Cursor="Hand" Tag="#FF6BD490" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFB85C" Cursor="Hand" Tag="#FFFFB85C" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FFFF7A7A" Cursor="Hand" Tag="#FFFF7A7A" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#FFFF7AC8" Cursor="Hand" Tag="#FFFF7AC8" Margin="14,0,0,0" MouseLeftButtonDown="AccentColor_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <ui:Button Appearance="Secondary" Content="自定义颜色" Click="CustomAccent_Click"/>
                        <ui:Button Appearance="Secondary" Content="恢复默认" Margin="12,0,0,0" Click="ResetAccent_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 外观（深 / 浅色） ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DarkTheme24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="选择界面深浅色。「跟随系统」会随 Windows 的浅色 / 深色模式自动切换。"
                               FontSize="13" Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeMode" Content="跟随系统"
                                     VerticalAlignment="Center" Tag="system" Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode" Content="浅色"
                                     Margin="20,0,0,0" VerticalAlignment="Center" Tag="light" Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode" Content="深色"
                                     Margin="20,0,0,0" VerticalAlignment="Center" Tag="dark" Checked="ThemeRadio_Checked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 服务器设置（维护用，默认隐藏） ============ 
                 这块只给维护者调接口地址 / 更新通道 / 开后台用，普通用户不该看到，
                 所以默认 Collapsed；在版本号上连点 5 下（见 AboutPage.xaml.cs
                 AboutVersion_Click）才会展开，且只在本次运行内有效，重启即恢复隐藏。 -->
            <Border x:Name="ServerSettingsCard" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cloud24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="服务器设置" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="配置接口地址与更新通道，用于公告、官方 ROM 包与在线更新。保存后立即生效。"
                               FontSize="13" Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="接口地址" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBox x:Name="ApiBaseUrlBox" Margin="0,6,0,0"/>

                    <TextBlock Text="更新通道" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="ApiChannelBox" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="180">
                        <ComboBoxItem Content="stable"/>
                        <ComboBoxItem Content="beta"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <ui:Button Appearance="Primary" Content="保存" Click="SaveApi_Click"/>
                        <ui:Button Appearance="Secondary" Content="恢复默认" Margin="12,0,0,0" Click="ResetApi_Click"/>
                        <ui:Button x:Name="TestApiButton" Appearance="Secondary" Content="测试连接"
                                   Margin="12,0,0,0" Click="TestApi_Click"/>
                        <ui:Button Appearance="Secondary" Content="打开后台" Margin="12,0,0,0"
                                   Click="OpenAdmin_Click"/>
                        <TextBlock x:Name="ApiStatusText" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 开源许可 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="开源许可" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="MosyTool 以 "/>
                        <Run Text="AGPL-3.0-or-later" FontWeight="SemiBold"/>
                        <Run Text=" 授权发布。许可证全文见随程序分发的 LICENSE 文件，修改与再分发需遵循同一许可。"/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="MTK 功能由 "/>
                        <Run Text="Penumbra (antumbra)" FontWeight="SemiBold"/>
                        <Run Text=" 提供，Copyright (C) Shomy，以 AGPL-3.0-or-later 授权，许可证见 tools/LICENSE-Penumbra.txt。"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:Button Appearance="Secondary" Content="Penumbra 源码"
                                   Click="PenumbraRepo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 特别感谢 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Star24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="特别感谢" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="MosyTool 的界面观感与不少功能思路，参考了 "/>
                        <Run Text="紫罗兰工具箱" FontWeight="SemiBold"/>
                        <Run Text="、"/>
                        <Run Text="刷机匣" FontWeight="SemiBold"/>
                        <Run Text=" 与 "/>
                        <Run Text="Penumbra" FontWeight="SemiBold"/>
                        <Run Text="。这些项目背后都是作者大量时间的投入，感谢他们把经验留在了开源社区里。"/>
                    </TextBlock>

                    <TextBlock Text="技术 / 测试支持（排名不分先后）" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <!-- 名单优先由接口填充，拉取失败时保留下面这份内置兜底 -->
                    <WrapPanel x:Name="SupportPanel" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,12">
                            <Border x:Name="AvatarSupMywl" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="m" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="mywl" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,12">
                            <Border x:Name="AvatarSupWanmo" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="挽" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="挽墨0MwㄨH0" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,12">
                            <Border x:Name="AvatarSupXxx" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="X" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="XXXXXXX" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,22,12">
                            <Border x:Name="AvatarSupPabibu" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="帕" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="帕比布皮帕" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="没有你们帮忙测试设备、反馈日志、反复验证，这个工具跑不到今天。谢谢。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============ 致谢 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="致谢" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="MosyTool 能走到今天，离不开下面这些开源项目。感谢它们的作者与所有贡献者。"
                               FontSize="13" Margin="0,8,0,2" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="mtkclient" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="MTK BROM / Preloader 协议、DA 加载与分区读写的参考实现 · Bjoern Kerler (bkerler)"
                                   FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Left"
                                   Content="打开仓库" Tag="https://github.com/bkerler/mtkclient"
                                   Click="RepoLink_Click"/>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="edl" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
