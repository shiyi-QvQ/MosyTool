<Page x:Class="Mosytool.Views.EdlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Mosytool.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="高通 EDL 工具">

    <Page.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 侧边上下滑动条：换成 App.xaml 里的细条，覆盖系统默认的粗轨道+箭头按钮 -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}"/>
    </Page.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部状态区 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="高通 EDL 工具" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="14,12" Margin="0,12,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Flash24" FontSize="18" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DeviceStatusText" Text="正在检测设备…" FontSize="13"
                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ToolStatusText" Text="正在检测…" FontSize="12"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2" x:Name="RefreshButton" Appearance="Secondary"
                               Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center"
                               Content="刷新状态" Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <Expander x:Name="LoaderExpander" Margin="0,0,0,8"
                      Header="装载器文件（firehose programmer，必填）"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <StackPanel Margin="4,12,4,4">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="programmer" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox Grid.Column="1" x:Name="ProgrammerBox"
                                    PlaceholderText="必填，选择 prog_firehose_*.elf / *.mbn"
                                    ToolTip="sahara 阶段推给设备的 firehose 装载器，通常取自对应机型的刷机包。"/>
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览" Click="ProgrammerBrowse_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="存储类型" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="MemoryCombo" SelectionChanged="MemoryCombo_SelectionChanged"
                                  ToolTip="留「自动」时由装载器自行探测；探测失败再手动指定。">
                            <ComboBoxItem Content="自动（推荐）" Tag=""/>
                            <ComboBoxItem Content="eMMC" Tag="eMMC"/>
                            <ComboBoxItem Content="UFS" Tag="UFS"/>
                            <ComboBoxItem Content="NAND" Tag="NAND"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- ==================== 主功能区 ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="GPT 分区表" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ui:Button x:Name="ConnectButton" Appearance="Secondary"
                                       Margin="16,0,0,0" Padding="10,4"
                                       Content="连接设备" Click="Connect_Click"/>
                            <ui:Button x:Name="DisconnectButton" Appearance="Secondary"
                                       Margin="8,0,0,0" Padding="10,4"
                                       Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
                            <ui:Button x:Name="LoadPartitionButton" Appearance="Secondary"
                                       Margin="8,0,0,0" Padding="10,4"
                                       Content="读取分区表" Click="LoadPartition_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="PartitionCountText"
                                   Text="尚未读取。连接设备后点击「读取分区表」。"
                                   FontSize="13" Margin="0,12,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <DataGrid x:Name="PartitionGrid" Height="320" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" FontSize="12"
                                  SelectionChanged="PartitionGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分区名"  Binding="{Binding Name}"          Width="1.2*"/>
                                <DataGridTextColumn Header="起始 LBA" Binding="{Binding FirstLbaHex}"  Width="1.1*"/>
                                <DataGridTextColumn Header="结束 LBA" Binding="{Binding LastLbaHex}"   Width="1.1*"/>
                                <DataGridTextColumn Header="扇区数"  Binding="{Binding Sectors}"       Width="*"/>
                                <DataGridTextColumn Header="大小"    Binding="{Binding SizeHuman}"     Width="0.9*"/>
                                <DataGridTextColumn Header="类型 GUID" Binding="{Binding TypeGuid}"    Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button x:Name="ExportPartitionButton" Appearance="Secondary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="导出 CSV" Click="ExportPartition_Click" IsEnabled="False"/>
                            <ui:Button x:Name="ExportRawprogramButton" Appearance="Secondary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="导出 rawprogram.xml" Click="ExportRawprogram_Click" IsEnabled="False"/>
                            <ui:Button x:Name="DetectSlotButton" Appearance="Secondary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="检测 A/B 槽位" Click="DetectSlot_Click" IsEnabled="False"/>
                            <ui:Button x:Name="BackupSelectedButton" Appearance="Secondary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="备份选中分区" Click="BackupSelected_Click" IsEnabled="False"/>
                            <ui:Button x:Name="WriteBackButton" Appearance="Primary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="写回镜像…" Click="WriteBack_Click" IsEnabled="False"/>
                            <ui:Button x:Name="EraseButton" Appearance="Secondary"
                                       Margin="0,0,8,0" Padding="10,4"
                                       Content="擦除选中分区…" Click="EraseSelected_Click" IsEnabled="False"/>
                        </WrapPanel>

                        <TextBlock x:Name="SlotInfoText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="单击选中一行；按住 Ctrl / Shift 可多选。备份为只读操作，不会修改设备。"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}">
                            <Run Text="写回 / 擦除会真实改写设备数据，出错可能导致机器无法开机。"/>
                            <Run Text="写回需指定一个存有「分区名.img」的镜像目录；擦除会把选中的分区整段清零。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="设备控制" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="从 EDL 复位：让设备退出 9008 并重新启动。复位成功后会话作废，设备会离开 EDL 模式。"
                                   FontSize="13" Margin="0,10,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ui:Button x:Name="ResetButton" Appearance="Primary" HorizontalAlignment="Left"
                                   Padding="14,5" Content="复位设备（退出 EDL）" Click="Reset_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 执行日志（可折叠） ==================== -->
        <Border Grid.Row="2" Margin="0,14,0,0" MinHeight="54"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,10">
            <Expander x:Name="LogExpander" IsExpanded="True"
                      HorizontalContentAlignment="Stretch"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      ToolTip="点标题可收起日志，把高度全部让给上方操作区">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText24" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="执行日志" Style="{StaticResource CardTitle}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                            <ui:Button x:Name="StopButton" Appearance="Secondary" Padding="10,4"
                                       Content="停止" Click="Stop_Click" IsEnabled="False"
                                       ToolTip="中断当前正在执行的操作。"/>
                            <ui:Button Appearance="Secondary" Margin="8,0,0,0" Padding="10,4"
                                       Content="清空" Click="ClearLog_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="高通原生层 "/>
                            <Run Text="qualcomm_ffi" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>
                </Expander.Header>

                <!-- ctl:LogView：按日志等级着色（错误红 / 警告黄 / 成功绿 / 细节灰 / 阶段标题强调色），不折行 -->
                <ctl:LogView x:Name="OutputBox" Height="150" Margin="0,10,0,0"
                             NoWrap="True" MaxChars="200000"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="0" Padding="10"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Expander>
        </Border>
    </Grid>
</Page>
