<controls:MtWindow x:Class="Mosytool.Views.RemoteDirWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Mosytool.Controls"
        Title="选择手机上的目录"
        Width="640" Height="600"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Title="选择手机上的目录" Icon="Folder24"/>

        <!-- 路径行：上一级 / 当前路径（可直接改） / 转到 -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="UpButton" Appearance="Secondary" Padding="10,4" Content="上一级"
                       Click="Up_Click" ToolTip="回到上一层目录"/>
            <ui:TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0,0,0"
                        PlaceholderText="设备内路径，例如 /sdcard/Download"
                        KeyDown="PathBox_KeyDown"/>
            <ui:Button Grid.Column="2" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0"
                       Content="转到" Click="Go_Click"/>
        </Grid>

        <!-- 常用目录 -->
        <WrapPanel x:Name="QuickPanel" Grid.Row="2" Margin="20,12,20,0"/>

        <!-- 子文件夹列表 -->
        <controls:SquircleBorder Grid.Row="3" Margin="20,4,20,0" CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="FolderList" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="FolderList_MouseDoubleClick"
                      KeyDown="FolderList_KeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:SquircleBorder>

        <!-- 在当前目录新建文件夹 -->
        <Grid Grid.Row="4" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="NewNameBox" PlaceholderText="在当前目录新建文件夹（可留空不用）"/>
            <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0"
                       Content="新建" Click="Create_Click"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="20,10,20,0" FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <Grid Grid.Row="6" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TargetText" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Padding="14,6" Content="取消" Click="Cancel_Click"/>
                <ui:Button x:Name="ConfirmButton" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Content="用这个目录" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</controls:MtWindow>
