<Page x:Class="Mosytool.Views.RomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="官方 ROM 包">

    <Page.Resources>
        <!-- ROM 列表项模板 -->
        <DataTemplate x:Key="RomRowTemplate">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tags}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Content="下载"
                                   IsEnabled="{Binding CanDownload}"
                                   Click="Download_Click"/>
                        <ui:Button Appearance="Secondary" Content="官方页" Margin="8,0,0,0"
                                   IsEnabled="{Binding HasPage}"
                                   Click="OpenPage_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <TextBlock Text="官方 ROM 包" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="数据来自上游官方仓库同步，仅提供检索与跳转" FontSize="14" Margin="0,6,0,20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="品牌" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <!-- 必须指定 DisplayMemberPath：条目类型是 record，
                                 WPF 默认调 ToString()，下拉框里就会蹦出
                                 “OptionItem { Value = ..., Text = ... }” 这种调试字符串。 -->
                            <ComboBox x:Name="BrandCombo" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Text"
                                      SelectionChanged="BrandCombo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="机型" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Text"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="类型" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="TypeCombo" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Text"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="关键字" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox x:Name="KeywordBox" PlaceholderText="版本号 / 文件名 / 机型"
                                        KeyDown="KeywordBox_KeyDown"/>
                        </StackPanel>

                        <ui:Button Grid.Column="4" Appearance="Primary" Content="查询" Margin="0,20,8,0"
                                   Icon="{ui:SymbolIcon Search24}" Click="Search_Click"/>
                        <ui:Button Grid.Column="5" Appearance="Secondary" Content="重置" Margin="0,20,0,0"
                                   Click="Reset_Click"/>
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="正在加载…" FontSize="12" Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="0,10,0,0" x:Name="DownloadPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DownloadProgress" Height="6" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" BorderThickness="0"/>
                        <ui:Button x:Name="CancelDownloadButton" Grid.Column="1" Margin="12,0,0,0"
                                   Appearance="Secondary" Content="取消下载" Click="CancelDownload_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,16,32,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RomList" ItemTemplate="{StaticResource RomRowTemplate}"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="32,8,32,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button x:Name="PrevButton" Appearance="Secondary" Content="上一页"
                           Click="Prev_Click"/>
                <TextBlock x:Name="PageText" Text="1 / 1" FontSize="13" Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:Button x:Name="NextButton" Appearance="Secondary" Content="下一页"
                           Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
