<ui:FluentWindow x:Class="Mosytool.Views.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="公告"
        Width="560" Height="480"
        MinWidth="440" MinHeight="320"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win12MicaBrush}"
        FontFamily="Microsoft YaHei UI">

    <Grid Background="{DynamicResource Win12MicaBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0"
                     Title="公告" Icon="{ui:SymbolIcon Alert24}"/>

        <!-- 正文卡片：等级徽章 / 置顶 / 时间 + 标题 + 可滚动内容 -->
        <Border Grid.Row="1" Margin="20,4,20,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20,16,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border x:Name="LevelBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="LevelText" Text="公告" FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="PinnedBadge" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="置顶" FontSize="11" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="DateText" Text="" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock x:Name="TitleText" Grid.Row="1" Text="" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 正文按 Markdown 渲染（标题 / 列表 / 引用 / 代码块 / 链接），
                     文档由 AnnouncementWindow.xaml.cs 里的 MarkdownRenderer 生成。
                     FlowDocumentScrollViewer 自带滚动条，所以这里不再套 ScrollViewer。 -->
                <FlowDocumentScrollViewer x:Name="ContentMarkdown" Grid.Row="2" Margin="0,14,0,0"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent" BorderThickness="0" Padding="0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="20,18,20,20">
            <ui:Button x:Name="MuteButton" Appearance="Secondary" Content="不再提醒"
                       Margin="0,0,12,0" Click="MuteButton_Click"/>
            <ui:Button x:Name="ConfirmButton" Appearance="Primary" Content="我知道了" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
