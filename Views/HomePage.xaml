<Page
      xmlns:controls="clr-namespace:Mosytool.Controls" x:Class="Mosytool.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="首页">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource Mt.PagePadding}">
                <TextBlock Text="概览" Style="{StaticResource Mt.PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="" Style="{StaticResource Mt.PageSubtitle}"/>

                <!-- ============ 设备信息 ============ -->
                <controls:SquircleBorder x:Name="DeviceCard" Style="{StaticResource Mt.Card}" Margin="0,20,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Phone24" Style="{StaticResource Mt.SectionIcon}"/>
                                <TextBlock Text="设备信息" Style="{StaticResource Mt.SectionTitle}"/>
                            </StackPanel>

                            <!-- 状态点 + 状态文本放在标题右侧：这一行就是"现在能不能干活"的答案 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="StateDot" Style="{StaticResource Mt.StatusDot}"/>
                                <TextBlock x:Name="DeviceState" Text="检测中" Style="{StaticResource Mt.Label}"
                                           Margin="7,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 主标题区：机型名放大，代号与序列号降级成辅助信息 -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="DeviceName" Text="-"
                                           FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="DeviceCodename" Text="-" FontSize="12.5" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <controls:SquircleBorder Grid.Column="1" Style="{StaticResource Mt.Pill}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SN" Style="{StaticResource Mt.Pill.Text}"/>
                                    <TextBlock x:Name="DeviceSerial" Text="-" Style="{StaticResource Mt.Pill.Text}"
                                               FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                               Margin="6,0,0,0" MaxWidth="200"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                            </controls:SquircleBorder>
                        </Grid>

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,16,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Android 版本" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceAndroidVersion" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="硬件平台" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceHardware" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="运行内存" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceRam" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="芯片平台" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceCpu" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="屏幕分辨率" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceResolution" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="系统版本" Style="{StaticResource Mt.Label}"/>
                                    <TextBlock x:Name="DeviceRomVersion" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,14,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内核版本" Style="{StaticResource Mt.Label}"/>
                            <TextBlock x:Name="DeviceKernel" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="构建编号" Style="{StaticResource Mt.Label}"/>
                            <TextBlock x:Name="DeviceBuild" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- ============ 电量与存储 ============ -->
                <!-- 三块指标：电池用环（一眼看剩余），储存和内存用条（一眼看占比）。
                     数值都由代码用 Anim.To 推上去，刷新时是滑过去的。 -->
                <controls:SquircleBorder x:Name="MeterCard" Style="{StaticResource Mt.Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="112" Height="112">
                                <ui:ProgressRing x:Name="BatteryRing" Progress="0"/>
                                <TextBlock x:Name="BatteryRingText" Text="--" FontSize="27" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="电池电量" Style="{StaticResource Mt.SectionTitle}"/>
                                <TextBlock x:Name="BatteryDetail" Text="-" Style="{StaticResource Mt.BodyMuted}"
                                           Margin="0,8,0,0" MaxWidth="180" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Mt.Divider}" Width="1" Height="Auto"
                                Margin="26,4,26,4" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- 内部储存 -->
                            <Grid>
                                <TextBlock Text="内部储存" Style="{StaticResource Mt.SectionTitle}"/>
                                <TextBlock x:Name="StorageNominalText" Text="" Style="{StaticResource Mt.Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="StorageBar" Style="{StaticResource Mt.Meter}" Margin="0,12,0,9"/>
                            <Grid>
                                <TextBlock x:Name="DeviceStorage" Text="-" Style="{StaticResource Mt.Meter.Value}"/>
                                <TextBlock x:Name="StorageFreeText" Text="" Style="{StaticResource Mt.Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 运行内存 -->
                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="运行内存" Style="{StaticResource Mt.SectionTitle}"/>
                                <TextBlock x:Name="RamNominalText" Text="" Style="{StaticResource Mt.Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="RamBar" Style="{StaticResource Mt.Meter}" Margin="0,12,0,9"/>
                            <Grid>
                                <TextBlock x:Name="RamUsedText" Text="-" Style="{StaticResource Mt.Meter.Value}"/>
                                <TextBlock x:Name="RamFreeText" Text="" Style="{StaticResource Mt.Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:SquircleBorder>

                <!-- ============ 模式切换 ============ -->
                <controls:SquircleBorder x:Name="ModeCard" Style="{StaticResource Mt.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PhoneLaptop24" Style="{StaticResource Mt.SectionIcon}"/>
                            <TextBlock Text="模式切换" Style="{StaticResource Mt.SectionTitle}"/>
                        </StackPanel>
                        <TextBlock x:Name="RebootHintText" Text="" Style="{StaticResource Mt.Caption}"
                                   Margin="0,10,0,4"/>

                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button x:Name="RebootSystemButton" Appearance="Primary" IsEnabled="False" Margin="0,0,10,10"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Content="回到系统" Click="RebootSystem_Click"/>
                            <ui:Button x:Name="RebootFastbootButton" Appearance="Secondary" IsEnabled="False" Margin="0,0,10,10"
                                       Content="进入 Fastboot" Click="RebootFastboot_Click"/>
                            <ui:Button x:Name="RebootFastbootdButton" Appearance="Secondary" IsEnabled="False" Margin="0,0,10,10"
                                       Content="进入 FastbootD" Click="RebootFastbootd_Click"/>
                            <ui:Button x:Name="RebootRecoveryButton" Appearance="Secondary" IsEnabled="False" Margin="0,0,10,10"
                                       Content="进入 Recovery" Click="RebootRecovery_Click"/>
                            <ui:Button x:Name="RebootEdlButton" Appearance="Secondary" IsEnabled="False" Margin="0,0,10,10"
                                       Content="进入 EDL" Click="RebootEdl_Click"/>
                        </WrapPanel>

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,10,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bootloader 锁" Style="{StaticResource Mt.Body}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Border x:Name="LockDot" Style="{StaticResource Mt.StatusDot}"/>
                                    <TextBlock x:Name="LockStateText" Text="未知（连接设备后自动检测）"
                                               Style="{StaticResource Mt.Label}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="UnlockButton" Appearance="Secondary" IsEnabled="False"
                                           Margin="0,0,10,0" Content="一键解锁 BL" Click="Unlock_Click"/>
                                <ui:Button x:Name="LockButton" Appearance="Secondary" IsEnabled="False"
                                           Content="回锁 BL" Click="Lock_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- ============ 快捷入口 ============ -->
                <!-- 常用工具平铺出来，省得每次去侧栏翻分组；按钮排布随宽度自动换列 -->
                <controls:SquircleBorder x:Name="QuickToolsCard" Style="{StaticResource Mt.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Rocket24" Style="{StaticResource Mt.SectionIcon}"/>
                            <TextBlock Text="快捷入口" Style="{StaticResource Mt.SectionTitle}"/>
                        </StackPanel>

                        <UniformGrid x:Name="QuickToolsGrid" Columns="3" Margin="0,16,0,-10">
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="fastboot" Icon="{ui:SymbolIcon Flash24}" Content="Fastboot 工具"
                                       Click="QuickTool_Click"/>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="adb" Icon="{ui:SymbolIcon PhoneDesktop24}" Content="ADB 工具"
                                       Click="QuickTool_Click"/>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="mtk" Icon="{ui:SymbolIcon Phone24}" Content="MTK 工具"
                                       Click="QuickTool_Click"/>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="edl" Icon="{ui:SymbolIcon Wrench24}" Content="高通 EDL 工具"
                                       Click="QuickTool_Click"/>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="super" Icon="{ui:SymbolIcon BoxMultiple24}" Content="super 工具"
                                       Click="QuickTool_Click"/>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,10,10"
                                       Tag="driver" Icon="{ui:SymbolIcon ArrowDownload24}" Content="驱动下载"
                                       Click="QuickTool_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- ============ 驱动检测 / 当前版本 ============ -->
                <Grid x:Name="SideToolsRow" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:SquircleBorder Style="{StaticResource Mt.Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="UsbStick24" Style="{StaticResource Mt.SectionIcon}"/>
                                <TextBlock Text="驱动检测" Style="{StaticResource Mt.SectionTitle}"/>
                            </StackPanel>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="DriverDot" Style="{StaticResource Mt.StatusDot}"/>
                                    <TextBlock x:Name="DeviceManagerStatus" Text="未检测"
                                               Style="{StaticResource Mt.Body}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Appearance="Secondary" Content="重新检测"
                                           Click="CheckDriver_Click"/>
                            </Grid>
                        </StackPanel>
                    </controls:SquircleBorder>

                    <controls:SquircleBorder Grid.Column="2" Style="{StaticResource Mt.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Style="{StaticResource Mt.SectionIcon}"/>
                                    <TextBlock Text="当前版本" Style="{StaticResource Mt.SectionTitle}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource Mt.Metric}"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                    </controls:SquircleBorder>
                </Grid>

                <!-- ============ 软件公告 ============ -->
                <controls:SquircleBorder x:Name="AnnouncementCard" Style="{StaticResource Mt.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="News24" Style="{StaticResource Mt.SectionIcon}"/>
                                <TextBlock Text="软件公告" Style="{StaticResource Mt.SectionTitle}"/>
                            </StackPanel>
                            <ui:Button x:Name="RefreshAnnouncementButton" Grid.Column="1"
                                       HorizontalAlignment="Right" Appearance="Transparent"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="刷新公告" Click="RefreshAnnouncement_Click"/>
                        </Grid>

                        <TextBlock x:Name="AnnouncementBox" TextWrapping="Wrap" LineHeight="21"
                                   Style="{StaticResource Mt.BodyMuted}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="AnnouncementList"/>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- ============ 刷机驱动 ============ -->
                <controls:SquircleBorder x:Name="DriverCard" Style="{StaticResource Mt.Card.Accent}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="UsbPlug24" Style="{StaticResource Mt.SectionIcon}"/>
                                <TextBlock Text="端口驱动" Style="{StaticResource Mt.SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="看端口挂在什么驱动上；9008 / MTK 端口可一键切换为 WinUSB。"
                                       Style="{StaticResource Mt.Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="DriverPageButton" Appearance="Primary"
                                       Icon="{ui:SymbolIcon UsbPlug24}"
                                       Content="打开端口驱动转换" Click="DriverPageButton_Click"/>
                            <ui:Button Appearance="Secondary" Margin="10,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="打开驱动目录" Click="OpenFolderButton_Click"/>
                        </StackPanel>
                    </Grid>
                </controls:SquircleBorder>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
