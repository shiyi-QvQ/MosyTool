<Window x:Class="Mosytool.Views.ClosingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="正在退出"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">

    <!-- 自绘卡片：关窗口时桌面已经“空了”，这里用一个带阴影的浮动面板说明在收尾，
         比让用户对着一个已经消失的窗口干等要清楚得多。 -->
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="26,24,26,22" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                 Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="正在退出 Mosytool…" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Margin="0,18,0,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdbMark" Text="○" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="AdbText" Grid.Column="1" Text="关闭 adb 进程" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FastbootMark" Text="○" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="FastbootText" Grid.Column="1" Text="关闭 fastboot 进程" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CleanMark" Text="○" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="CleanText" Grid.Column="1" Text="清理软件进程" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="准备退出…" FontSize="12.5" Margin="0,18,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
    </Border>
</Window>
