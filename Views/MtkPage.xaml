<Page x:Class="Mosytool.Views.MtkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Mosytool.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="MTK 工具">

    <Page.Resources>
        <!-- 卡片标题 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- 卡片内的小分组标题 -->
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 表单左侧的字段名 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 卡片：统一边框与留白，避免每张卡重复写四行属性 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <!-- 卡片标题左侧的图标 -->
        <Style x:Key="CardIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- 卡片标题文字 -->
        <Style x:Key="CardHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- 卡片下的说明文字 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 卡片下边距：让纵向排列的卡片间距一致 -->
        <Style x:Key="CardSpacing" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- 侧边上下滑动条：换成 App.xaml 里的细条，覆盖系统默认的粗轨道+箭头按钮 -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}"/>

        <!-- ================= 侧栏「操作」列表 =================
             借鉴 Antumbra GUI 的布局：左侧一列竖排操作项，选中项用强调色竖条 + 淡底标识。
             导航交给 ListBox，内容交给隐藏了 TabStrip 的 TabControl，
             两者用 SelectedIndex 双向绑定保持同步。这样侧栏的宽度、滚动、
             选中态全在自己手里，不再受 TabControl 模板对 TabStripPlacement 的实现影响。
             内容面板本身仍然是 TabItem，所以各控件的 x:Name 与事件签名都不用动。 -->
        <SolidColorBrush x:Key="SideNavItemHover"    Color="#14000000"/>
        <SolidColorBrush x:Key="SideNavItemSelected" Color="#1F3B91D8"/>

        <!-- 侧栏项宽度 214 = 根 Grid 侧栏列宽；右侧 16 是留给内容区的空隙。
             两者必须对得上，否则内容面板会与侧栏错位。 -->
        <Style x:Key="SideNavItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="214"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8"
                                Margin="0,1,16,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 选中指示条：平时透明，选中才染强调色 -->
                                <Border x:Name="Mark" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="Transparent" Margin="0,7,0,7"/>

                                <ContentPresenter Grid.Column="1" ContentSource="Content"
                                                  Margin="12,9,10,9" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- IsSelected 写在后面：鼠标停在选中项上时仍然是选中态配色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SideNavItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg"  Property="Background"
                                        Value="{StaticResource SideNavItemSelected}"/>
                                <Setter TargetName="Mark" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏容器：去掉 ListBox 自带的边框与底色 -->
        <Style x:Key="SideNav" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- 侧栏项内容：图标 + 名称。图标颜色靠继承 ListBoxItem.Foreground 拿到，
             所以选中时字和图标会一起变主色，不用单独写绑定。 -->
        <Style x:Key="SideNavIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 内容承载区：TabStrip 完全隐藏，只按 SelectedContent 渲染当前面板。
             TabControl 在这里只当「内容切换器」用，导航由左侧 ListBox 负责。 -->
        <Style x:Key="ContentOnlyTabs" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 内容区每个面板的标题，形如「分区管理 (Partitions)」 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- 标题后面的英文小注 -->
        <Style x:Key="PanelTitleEn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- 操作列表上方的分组标题（操作 / 日志） -->
        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <!-- 顶部：左右两列的分组标题（操作 / 日志） -->
            <RowDefinition Height="Auto"/>
            <!-- 中部：左「操作」侧栏 + 中操作面板 + 右日志。窗口越高，这里越大 -->
            <RowDefinition Height="*" MinHeight="260"/>
            <!-- 底部：设备状态条。对应 Antumbra 底部那条 "Antumbra • Waiting for MTK device…" -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- 侧栏列宽必须与 SideNavItem 的 Width 一致，否则内容面板会与侧栏错位 -->
            <ColumnDefinition Width="214"/>
            <!-- 中间：当前操作的面板。给个宽度下限，窗口收窄时不会把卡片里的表单压到看不出内容 -->
            <ColumnDefinition Width="*" MinWidth="380"/>
            <!-- 侧栏/日志之间的呼吸空隙 -->
            <ColumnDefinition Width="20"/>
            <!-- 右侧：执行日志 -->
            <ColumnDefinition Width="320" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="操作" Style="{StaticResource ColumnHead}"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="日志" Style="{StaticResource ColumnHead}"/>

        <!-- ==================== 侧栏：操作导航 ====================
             只用它做导航，选中项索引双向同步给下面的 TabControl。
             项的顺序必须与 TabControl 里 TabItem 的顺序一一对应。 -->
        <ListBox Grid.Row="1" Grid.Column="0" x:Name="OperationList" SelectedIndex="0"
                 Style="{StaticResource SideNav}">
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Phone24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="设备控制" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Box24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="分区管理" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="DeveloperBoard24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="高级读写" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="LockClosed24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="安全区" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Flash24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="整包刷写" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Style="{StaticResource SideNavItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource SideNavIcon}"/>
                    <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!-- ==================== 主功能区 ====================
             TabStrip 已在 ContentOnlyTabs 模板里去掉，这里只渲染当前选中的面板，
             切换完全由左侧 ListBox 的索引驱动。 -->
        <TabControl Grid.Row="1" Grid.Column="1" Style="{StaticResource ContentOnlyTabs}"
                    SelectedIndex="{Binding SelectedIndex, ElementName=OperationList, Mode=TwoWay}">

            <!-- 设备控制 -->
            <TabItem Header="设备控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="设备控制" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Device" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>
                    <Border Style="{StaticResource CardSpacing}">
                        <StackPanel>
                            <TextBlock Text="重启与开关机" Style="{StaticResource SubHeader}"/>
                            <WrapPanel>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="重启到系统" Click="DevRebootSystem_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="重启到 Fastboot" Click="DevRebootFastboot_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="重启到 Home" Click="DevRebootHome_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="重启到 Meta" Click="DevRebootMeta_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="重启到 Test" Click="DevRebootTest_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="关机" Click="DevShutdown_Click"/>
                            </WrapPanel>

                            <TextBlock Text="启动槽（系统 A / B）" Style="{StaticResource SubHeader}" Margin="0,6,0,8"/>
                            <WrapPanel>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="切到槽 A" Click="DevSlotA_Click"
                                           ToolTip="切换下次开机使用的系统槽。槽内固件不完整会导致无法开机。"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="切到槽 B" Click="DevSlotB_Click"
                                           ToolTip="切换下次开机使用的系统槽。槽内固件不完整会导致无法开机。"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="查看当前槽" Click="DevActiveSlot_Click"/>
                            </WrapPanel>

                            <TextBlock Text="设备信息（只读，不影响设备）" Style="{StaticResource SubHeader}"
                                       Margin="0,6,0,8"/>
                            <WrapPanel>
                                <ui:Button Appearance="Primary" Margin="0,0,8,8" Padding="12,4"
                                           Content="存储信息" Click="DevStorageInfo_Click"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="芯片信息" Click="DevInfo_Click"
                                           ToolTip="读取硬件代码、SoC ID、目标配置等芯片级信息，用于确认机型和平台。"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="设备密钥" Click="DevKeys_Click"
                                           ToolTip="读取 RPMB、FDE 等密钥，用于确认设备状态。属于敏感信息，请勿外传。"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="读取 eFuse" Click="DevEfuseRead_Click"/>
                            </WrapPanel>

                            <TextBlock Text="eFuse 烧写（一次性、不可逆）" Style="{StaticResource SubHeader}"
                                       Margin="0,6,0,8"/>
                            <WrapPanel>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="写入 eFuse" Click="DevEfuseWrite_Click"
                                           ToolTip="把 eFuse 数据文件烧入设备。eFuse 是单向熔丝，写完无法修改也无法擦除，出错后设备永久无法修复。"/>
                            </WrapPanel>

                            <TextBlock Text="引导校验（seccfg）" Style="{StaticResource SubHeader}" Margin="0,6,0,8"/>
                            <WrapPanel>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="解锁引导校验" Click="DevSeccfgUnlock_Click"
                                           ToolTip="关闭引导签名校验，允许启动自编译系统。会改变设备安全状态。"/>
                                <ui:Button Appearance="Secondary" Margin="0,0,8,8" Padding="10,4"
                                           Content="恢复引导校验" Click="DevSeccfgLock_Click"
                                           ToolTip="恢复官方签名校验。刷回官方固件前建议改回此状态。"/>
                            </WrapPanel>

                            <TextBlock Text="强制进入 BROM（应急）" Style="{StaticResource SubHeader}"
                                       Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Secondary" Margin="0,0,12,0" Padding="10,4"
                                           Content="崩溃至 BROM" Click="DevCrash_Click"
                                           ToolTip="强制设备立即崩溃并重启到 BROM 模式。仅在设备无响应、其他方式都连不上时使用。"/>
                                <TextBlock Text="用掉一次开机机会，之后需重新断电再进模式。"
                                           Style="{StaticResource FieldLabel}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 分区管理 -->
            <TabItem Header="分区管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="分区管理" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Partitions" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>
                            <Border Style="{StaticResource CardSpacing}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Box24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="分区表" Style="{StaticResource CardHead}"/>
                                        <ui:Button x:Name="LoadPartitionButton" Appearance="Secondary"
                                                   Margin="16,0,0,0" Padding="10,4"
                                                   Content="读取分区表" Click="LoadPartition_Click"/>
                                        <ui:Button x:Name="ExportPartitionButton" Appearance="Secondary"
                                                   Margin="8,0,0,0" Padding="10,4"
                                                   Content="导出 CSV" Click="ExportPartition_Click"
                                                   IsEnabled="False"/>
                                        <ui:Button x:Name="BackupSelectedButton" Appearance="Secondary"
                                                   Margin="8,0,0,0" Padding="10,4"
                                                   Content="备份选中" Click="BackupSelected_Click"
                                                   IsEnabled="False"/>
                                        <ui:Button x:Name="EraseSelectedButton" Appearance="Secondary"
                                                   Margin="8,0,0,0" Padding="10,4"
                                                   Content="擦除选中" Click="EraseSelected_Click"
                                                   IsEnabled="False"/>
                                    </StackPanel>

                                    <TextBlock x:Name="PartitionCountText"
                                               Text="尚未读取，点击「读取分区表」获取设备分区。"
                                               FontSize="13" Margin="0,12,0,10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                    <ui:TextBox x:Name="PartFilterBox" Margin="0,0,0,10"
                                                PlaceholderText="筛选分区：分区名 / 类型，空格或逗号分隔多个关键字"
                                                TextChanged="PartFilter_Changed"/>

                                    <DataGrid x:Name="PartitionGrid" Height="300" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              SelectionMode="Extended" SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" FontSize="12"
                                              SelectionChanged="PartitionGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="分区名"   Binding="{Binding Name}"       Width="1.2*"/>
                                            <DataGridTextColumn Header="起始地址" Binding="{Binding AddressHex}" Width="1.3*"/>
                                            <DataGridTextColumn Header="大小"     Binding="{Binding SizeHuman}"  Width="0.9*"/>
                                            <DataGridTextColumn Header="字节"     Binding="{Binding SizeHex}"    Width="1.3*"/>
                                            <DataGridTextColumn Header="类型"     Binding="{Binding Section}"    Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="单击选中一行（会自动填入「分区读写」的分区名）；按住 Ctrl / Shift 可多选，再用「备份选中」把所选分区存成一个备份集。"
                                               FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardSpacing}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="分区读写" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="目标" Style="{StaticResource SubHeader}" Margin="0,16,0,8"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="分区名" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="PartNameBox"
                                                    PlaceholderText="例如 boot、super（可直接输入，或在上方分区表点击）"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="镜像文件" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="ImageFileBox"
                                                    PlaceholderText="读取时作为保存位置，写入时作为镜像来源"/>
                                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                                   Click="ImageBrowse_Click"/>
                                    </Grid>

                                    <TextBlock Text="读取（不会修改设备）" Style="{StaticResource SubHeader}"/>
                                    <WrapPanel Margin="0,0,0,16">
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="读取分区（upload）" Click="ReadPart_Click"/>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="读取分区（read-flash）" Click="ReadFlashPart_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="写入与擦除（会修改设备）" Style="{StaticResource SubHeader}"/>
                                    <WrapPanel>
                                        <ui:Button Appearance="Primary" Margin="0,0,10,10"
                                                   Content="写入分区（download）" Click="WritePart_Click"/>
                                        <ui:Button Appearance="Primary" Margin="0,0,10,10"
                                                   Content="写入分区（write-flash）" Click="WriteFlashPart_Click"/>
                                        <ui:Button Appearance="Primary" Margin="0,0,10,10"
                                                   Content="写入分区（write-partition）"
                                                   Click="WritePartition_Click"
                                                   ToolTip="直接按分区名写入，不做 download 的大小校验。仅当镜像与分区大小不一致、download 被拒绝时才用。"/>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="格式化分区（format）" Click="FormatPart_Click"/>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="擦除分区（erase）" Click="ErasePart_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        <!-- 整机读取 / 整机写入 并排，省一屏高度 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="整机读取" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="把设备上所有分区逐个保存为 &lt;分区名&gt;.bin。分区较多、耗时较长。"
                                               Style="{StaticResource Hint}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="输出目录" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="ReadAllDirBox"
                                                    PlaceholderText="选择用于存放全部镜像的目录"/>
                                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                                   Click="ReadAllBrowse_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="跳过" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="SkipBox"
                                                    PlaceholderText="可选，逗号分隔的分区名，例如 userdata,metadata"/>
                                    </Grid>

                                    <ui:Button Appearance="Secondary" Content="读取所有分区" Click="ReadAll_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="整机写入" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="把目录中与分区同名的 &lt;分区名&gt;.bin 逐个写回设备；目录里没有对应镜像的分区会被跳过。"
                                               Style="{StaticResource Hint}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="镜像目录" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="WriteAllDirBox"
                                                    PlaceholderText="选择内含分区镜像的目录"/>
                                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                                   Click="WriteAllBrowse_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="跳过" Style="{StaticResource FieldLabel}"/>
                                        <ui:TextBox Grid.Column="1" x:Name="WriteAllSkipBox"
                                                    PlaceholderText="可选，逗号分隔的分区名，例如 userdata,metadata"/>
                                    </Grid>

                                    <ui:Button Appearance="Primary" Content="写入所有分区" Click="WriteAll_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="高级读写">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="高级读写" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Raw R/W" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flash24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="按偏移读写" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="直接按十六进制地址与长度访问 flash，不经过分区表。"
                                               Style="{StaticResource Hint}"/>

                                    <TextBlock Text="地址（hex）" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="OffsetAddrBox" Margin="0,0,0,12"
                                                PlaceholderText="例如 0x0"/>

                                    <TextBlock Text="长度（hex）" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="OffsetLenBox" Margin="0,0,0,12"
                                                PlaceholderText="例如 0x100000"/>

                                    <TextBlock Text="文件" Style="{StaticResource SubHeader}"/>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="OffsetFileBox"
                                                    PlaceholderText="读取时保存，写入时取源"/>
                                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                                   Click="OffsetBrowse_Click"/>
                                    </Grid>

                                    <WrapPanel>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="读取偏移" Click="ReadOffset_Click"/>
                                        <ui:Button Appearance="Primary" Margin="0,0,10,10"
                                                   Content="写入偏移" Click="WriteOffset_Click"/>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="擦除偏移" Click="EraseOffset_Click"
                                                   ToolTip="擦除指定地址与长度范围内的 flash 数据，操作不可恢复。"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Info24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="内存读写" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="直接读写设备内存（peek / poke）。地址填错可能立即导致设备异常，仅在明确知道目标地址时使用。"
                                               Style="{StaticResource Hint}"/>

                                    <TextBlock Text="地址（hex）" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="MemAddrBox" Margin="0,0,0,12"
                                                PlaceholderText="例如 0x40000000"/>

                                    <TextBlock Text="长度（hex）" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="MemLenBox" Margin="0,0,0,12"
                                                PlaceholderText="读取时必填"/>

                                    <TextBlock Text="文件" Style="{StaticResource SubHeader}"/>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="MemFileBox"
                                                    PlaceholderText="读取时保存，写入时取源"/>
                                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                                   Click="MemBrowse_Click"/>
                                    </Grid>

                                    <WrapPanel>
                                        <ui:Button Appearance="Secondary" Margin="0,0,10,10"
                                                   Content="读取内存（peek）" Click="Peek_Click"/>
                                        <ui:Button Appearance="Primary" Margin="0,0,10,10"
                                                   Content="写入内存（poke）" Click="Poke_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 寄存器读写：peek/poke 面向「内存 + 文件」，而寄存器只关心一个 32 位值 -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="寄存器读写（32 位）" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="直接读写设备的 32 位寄存器，不经过文件。地址填错可能立即导致设备异常，仅在明确知道目标寄存器时使用。"
                                           Style="{StaticResource Hint}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="地址（hex）" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="RegAddrBox"
                                                PlaceholderText="例如 0x10000000"/>
                                    <TextBlock Grid.Column="3" Text="值（hex）" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="4" x:Name="RegValueBox"
                                                PlaceholderText="写入时必填，例如 0x1"/>
                                </Grid>

                                <WrapPanel>
                                    <ui:Button Appearance="Secondary" Margin="0,0,10,0"
                                               Content="读取寄存器" Click="RegRead_Click"/>
                                    <ui:Button Appearance="Primary"
                                               Content="写入寄存器" Click="RegWrite_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 安全区 ========== -->
            <TabItem Header="安全区">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="安全区" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Security" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardSpacing}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockClosed24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="RPMB 数据区" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="RPMB 存放指纹、密钥等受保护数据。写入与认证需要正确的密钥，写入与擦除都不可逆，请务必先完整读取备份。"
                                           Style="{StaticResource Hint}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="区域" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="RpmbRegionBox" Text="0"/>
                                    <TextBlock Grid.Column="2" Text="起始扇区" Style="{StaticResource FieldLabel}"
                                               Margin="12,0,0,0"/>
                                    <ui:TextBox Grid.Column="3" x:Name="RpmbStartBox" Text="0"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="扇区数" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="RpmbCountBox"
                                                PlaceholderText="留空直到末尾"/>
                                    <TextBlock Grid.Column="2" Text="认证密钥" Style="{StaticResource FieldLabel}"
                                               Margin="12,0,0,0"/>
                                    <ui:TextBox Grid.Column="3" x:Name="RpmbKeyBox"
                                                PlaceholderText="十六进制字符串"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="数据文件" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="RpmbFileBox"
                                                PlaceholderText="读取时保存，写入时取源"/>
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                               Click="RpmbBrowse_Click"/>
                                </Grid>

                                <WrapPanel>
                                    <ui:Button Appearance="Secondary" Margin="0,0,10,0"
                                               Content="读取 RPMB" Click="RpmbRead_Click"/>
                                    <ui:Button Appearance="Primary" Margin="0,0,10,0"
                                               Content="写入 RPMB" Click="RpmbWrite_Click"/>
                                    <ui:Button Appearance="Secondary" Margin="0,0,10,0"
                                               Content="认证 RPMB" Click="RpmbAuth_Click"/>
                                    <ui:Button Appearance="Secondary"
                                               Content="擦除 RPMB" Click="RpmbErase_Click"
                                               ToolTip="擦除指定扇区范围内的 RPMB 数据。擦除后指纹 / 密钥不可恢复，请先完整读取备份。"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- RPMB 锁状态：与 seccfg 是两套机制，且仅 UFS 生效 -->
                        <Border Style="{StaticResource CardSpacing}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockOpen24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="RPMB 锁状态" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="控制 RPMB 安全分区本身是否可写，与「引导校验（seccfg）」是两套独立机制，且只对 UFS 存储生效。解锁会把 RPMB 恢复为默认密钥状态，可能使已写入的受保护数据不可读，请先备份。"
                                           Style="{StaticResource Hint}"/>

                                <WrapPanel>
                                    <ui:Button Appearance="Secondary" Margin="0,0,10,0"
                                               Content="锁定 RPMB" Click="RpmbLock_Click"
                                               ToolTip="把 RPMB 置为锁定状态。"/>
                                    <ui:Button Appearance="Primary"
                                               Content="解锁 RPMB" Click="RpmbUnlock_Click"
                                               ToolTip="把 RPMB 置为解锁（默认密钥）状态，仅 UFS 存储可用。"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- SEJ AES 与密钥派生：都只用设备内部密钥，不落盘 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Key24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="SEJ AES 加解密" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="用设备的安全引擎（SEJ / HACC）做 AES 运算，密钥始终留在芯片内。输出文件与输入文件等长。"
                                               Style="{StaticResource Hint}"/>

                                    <TextBlock Text="输入文件" Style="{StaticResource SubHeader}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="SejInBox" PlaceholderText="待处理的文件"/>
                                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                                   Click="SejInBrowse_Click"/>
                                    </Grid>

                                    <TextBlock Text="输出文件" Style="{StaticResource SubHeader}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="SejOutBox" PlaceholderText="结果保存位置"/>
                                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                                   Click="SejOutBrowse_Click"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="SejEncryptRadio" Content="加密" IsChecked="True"
                                                     GroupName="SejMode"/>
                                        <RadioButton x:Name="SejDecryptRadio" Content="解密" Margin="16,0,0,0"
                                                     GroupName="SejMode"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="密钥类型" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="SejKeyIdCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="sw（软件密钥）"/>
                                            <ComboBoxItem Content="hw（硬件密钥）"/>
                                            <ComboBoxItem Content="hw_wrapped（硬件封装）"/>
                                            <ComboBoxItem Content="rid（RID 密钥）"/>
                                            <ComboBoxItem Content="custom（自定义）"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="3" Text="密钥长度" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="4" x:Name="SejKeySizeCombo" SelectedIndex="2">
                                            <ComboBoxItem Content="128"/>
                                            <ComboBoxItem Content="192"/>
                                            <ComboBoxItem Content="256"/>
                                        </ComboBox>
                                    </Grid>

                                    <WrapPanel Margin="0,0,0,14">
                                        <CheckBox x:Name="SejCbcCheck" Content="CBC" IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  ToolTip="关闭则使用 ECB 模式。"/>
                                        <CheckBox x:Name="SejAntiCloneCheck" Content="防克隆" Margin="16,0,0,0"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox x:Name="SejLegacyCheck" Content="legacy" Margin="16,0,0,0"
                                                  VerticalAlignment="Center"/>
                                        <CheckBox x:Name="SejXorCheck" Content="XOR" Margin="16,0,0,0"
                                                  VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <ui:Button Appearance="Primary" Content="执行 SEJ 运算" Click="SejRun_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Key24" Style="{StaticResource CardIcon}"/>
                                        <TextBlock Text="自定义密钥派生" Style="{StaticResource CardHead}"/>
                                    </StackPanel>

                                    <TextBlock Text="按自定义 label / salt 从设备密钥派生新密钥。两者以 0x 开头时按十六进制解析，否则按文本处理；结果以十六进制写入日志。"
                                               Style="{StaticResource Hint}"/>

                                    <TextBlock Text="label" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="KeyLabelBox" Margin="0,0,0,12"
                                                PlaceholderText="文本，或以 0x 开头的十六进制"/>

                                    <TextBlock Text="salt" Style="{StaticResource SubHeader}"/>
                                    <ui:TextBox x:Name="KeySaltBox" Margin="0,0,0,12"
                                                PlaceholderText="文本，或以 0x 开头的十六进制"/>

                                    <TextBlock Text="长度" Style="{StaticResource SubHeader}"/>
                                    <ComboBox x:Name="KeySizeCombo" Margin="0,0,0,16" SelectedIndex="2">
                                        <ComboBoxItem Content="128"/>
                                        <ComboBoxItem Content="192"/>
                                        <ComboBoxItem Content="256"/>
                                    </ComboBox>

                                    <ui:Button Appearance="Primary" Content="派生密钥" Click="KeyDerive_Click"
                                               ToolTip="结果属于敏感信息，请勿外传。"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 整包刷写 ========== -->
            <TabItem Header="整包刷写">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="整包刷写" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Scatter Flash" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardSpacing}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="scatter 整包刷写" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="按 scatter（分区表 XML）逐个刷入镜像。scatter 内的镜像路径以该文件所在目录为基准解析，因此镜像需与 scatter 一同放置，或按 scatter 中的相对路径放好。"
                                           Style="{StaticResource Hint}"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="scatter 文件" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="ScatterFileBox"
                                                PlaceholderText="选择 MTKxxx_Android_scatter.xml"/>
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                               Click="ScatterBrowse_Click"/>
                                </Grid>

                                <ui:Button Appearance="Primary" Content="开始整包刷写" Click="ScatterFlash_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- XFlash 单分区刷写：与 scatter 同属「刷写」，放同一面板 -->
                        <Border Style="{StaticResource CardSpacing}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="XFlash 专用刷写（rsc-flash）" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="按分区名单独刷入一个镜像，走 rsc-flash 通道。适合只重刷个别分区，不必跑完整个 scatter。"
                                           Style="{StaticResource Hint}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="分区名" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="XfPartBox" PlaceholderText="目标分区"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="镜像文件" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="XfFileBox" PlaceholderText="要刷入的镜像"/>
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览" Click="XfBrowse_Click"/>
                                </Grid>

                                <ui:Button Appearance="Primary" Content="XFlash 刷写" Click="XfFlash_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- BROM payload 注入：只在 BROM 模式下可用 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Style="{StaticResource CardIcon}"/>
                                    <TextBlock Text="BROM payload 注入" Style="{StaticResource CardHead}"/>
                                </StackPanel>

                                <TextBlock Text="借助 BROM exploit 把 payload 送进设备并跳转执行。选 Preloader 文件时会解析 GFH 头自动推导加载地址；选「裸 payload」时必须手填地址。仅在 BROM 模式下可用。"
                                           Style="{StaticResource Hint}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="payload" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="BootPlFileBox"
                                                PlaceholderText="Preloader 文件或裸 payload 文件"/>
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览"
                                               Click="BootPlBrowse_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="加载地址" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox Grid.Column="1" x:Name="BootPlAddrBox"
                                                PlaceholderText="留空则按 Preloader 头自动推导；如 0x201000"/>
                                    <CheckBox Grid.Column="2" x:Name="BootPlRawCheck" Margin="12,0,0,0"
                                              VerticalAlignment="Center" Content="裸 payload"/>
                                </Grid>

                                <ui:Button Appearance="Primary" Content="注入并执行" Click="BootPlInject_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 设置：引导文件与高级选项。原先横在页面顶部，现在收进侧栏最后一项，
                 与 Antumbra 把通用选项放进侧栏底部的做法一致。 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="设置" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Settings" Style="{StaticResource PanelTitleEn}"/>
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- 引导文件：标题上直接写摘要，要改再展开 -->
                                <Expander x:Name="BootFilesExpander" IsExpanded="True"
                                          Header="引导文件（多数操作需要 DA 文件）"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <StackPanel Margin="4,12,4,4">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DA 文件" Style="{StaticResource FieldLabel}"/>
                                            <ui:TextBox Grid.Column="1" x:Name="DaFileBox"
                                                        PlaceholderText="必填，选择 DA / loader 文件"
                                                        ToolTip="进入 DA 模式所需。绝大多数分区读写操作都依赖它。"/>
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览" Click="DaBrowse_Click"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Preloader" Style="{StaticResource FieldLabel}"/>
                                            <ui:TextBox Grid.Column="1" x:Name="PlFileBox"
                                                        PlaceholderText="可选"
                                                        ToolTip="XFlash 类设备在 BROM 模式下需要。不确定就留空。"/>
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览" Click="PlBrowse_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Auth 文件" Style="{StaticResource FieldLabel}"/>
                                            <ui:TextBox Grid.Column="1" x:Name="AuthFileBox"
                                                        PlaceholderText="可选"
                                                        ToolTip="DAA / SLA 类设备在 BROM 模式下需要。不确定就留空。"/>
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="浏览" Click="AuthBrowse_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Separator Margin="0,12,0,4"/>

                                <!-- 高级选项 -->
                                <Expander Header="高级选项" IsExpanded="True"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <WrapPanel Margin="4,12,4,4">
                                        <CheckBox x:Name="VerboseCheck" Content="详细日志"
                                                  VerticalAlignment="Center" Click="Options_Changed"
                                                  ToolTip="排查设备识别问题时才需要。打开后会额外输出 USB 逐设备枚举等调试信息，日志量很大。"/>
                                        <CheckBox x:Name="UsbLogCheck" Content="USB DA 日志" Margin="20,0,0,0"
                                                  VerticalAlignment="Center" Click="Options_Changed"
                                                  ToolTip="输出原生层与 DA 之间的 USB 通信明细，用于排查读写失败。改动后需重新连接设备才会生效。"/>
                                        <CheckBox x:Name="UseLibusbCheck" Content="libusb 后端" Margin="20,0,0,0"
                                                  VerticalAlignment="Center" Click="Options_Changed"
                                                  ToolTip="部分机型必须走 libusb 才能完成漏洞利用阶段的握手。默认关闭。改动后需重新连接设备才会生效。"/>
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ==================== 执行日志（右栏） ==================== -->
        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText24" FontSize="18" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="执行日志" Style="{StaticResource CardTitle}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2" Appearance="Secondary" Margin="8,0,0,0" Padding="10,4"
                               VerticalAlignment="Top" Content="清空" Click="ClearLog_Click"/>
                </Grid>

                <!-- ctl:LogView：按日志等级着色（错误红 / 警告黄 / 成功绿 / 细节灰 / 阶段标题强调色），不折行 -->
                <ctl:LogView Grid.Row="1" x:Name="OutputBox" Margin="0,12,0,0" MinHeight="120"
                             NoWrap="True" MaxChars="200000"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderThickness="0" Padding="10"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- ==================== 底部状态条 ====================
             对应 Antumbra 底部那条 "Antumbra • Waiting for MTK device…"：
             左边是设备与内核状态，右边是「停止」，运行时状态一眼可见。 -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,14,0,0"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Phone24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceStatusText" Text="正在检测设备…" FontSize="13"
                               TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ToolStatusText" Text="正在检测…" FontSize="11"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ui:Button Grid.Column="2" x:Name="RefreshButton" Appearance="Secondary"
                           Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center"
                           Content="刷新状态" Click="RefreshButton_Click"/>
                <ui:Button Grid.Column="3" x:Name="StopButton" Appearance="Secondary"
                           Margin="8,0,0,0" Padding="18,4" VerticalAlignment="Center"
                           Content="停止" Click="Stop_Click" IsEnabled="False"
                           ToolTip="中断当前正在执行的操作。"/>
            </Grid>
        </Border>
    </Grid>
</Page>
