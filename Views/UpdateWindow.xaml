<controls:MtWindow x:Class="Mosytool.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Mosytool.Controls"
        Title="软件更新"
        Width="560" Height="470"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Title="软件更新" Icon="ArrowDownload24"/>

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="发现新版本" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MetaText" Text="" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <Border x:Name="ForceBadge" Grid.Column="1" Visibility="Collapsed"
                        Background="#D13438" CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Top">
                    <TextBlock Text="强制更新" FontSize="11" Foreground="White"/>
                </Border>
            </Grid>

            <controls:SquircleBorder Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="更新内容" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- 更新日志是 Markdown：直接塞进 TextBlock 会把 "##"、"**"、"- " 这些
                         标记原样显示出来，用户看到的就是一堆「多余的代码」。走渲染器排版。 -->
                    <FlowDocumentScrollViewer x:Name="ChangelogViewer" MaxHeight="160" Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False" IsSelectionEnabled="True"
                                              Background="Transparent" BorderThickness="0" Padding="0"/>
                </StackPanel>
            </controls:SquircleBorder>

            <ProgressBar x:Name="Progress" Height="6" Margin="0,18,0,0" Visibility="Collapsed"
                         Minimum="0" Maximum="100" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Text="" FontSize="12.5" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,20,24,20">
            <ui:Button x:Name="SkipButton" Appearance="Secondary" Content="跳过此版本"
                       Margin="0,0,12,0" Click="SkipButton_Click"/>
            <ui:Button x:Name="LaterButton" Appearance="Secondary" Content="稍后再说"
                       Margin="0,0,12,0" Click="LaterButton_Click"/>
            <ui:Button x:Name="UpdateButton" Appearance="Primary" Content="立即更新"
                       Icon="{ui:SymbolIcon ArrowDownload24}" Click="UpdateButton_Click"/>
        </StackPanel>
    </Grid>
</controls:MtWindow>
