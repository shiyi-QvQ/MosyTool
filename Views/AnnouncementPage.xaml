<Page x:Class="Mosytool.Views.AnnouncementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="公告">
    <Page.Resources>
        <!-- 列表项：左侧一根等级色条 + 标题/预览/时间，选中态交给 WPF-UI 的 ListBoxItem 样式 -->
        <Style x:Key="AnnouncementListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource Mt.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Mt.PageTitle}" Text="公告" />
                <TextBlock Style="{StaticResource Mt.PageSubtitle}"
                           Text="官方更新说明与重要提醒，正文按 Markdown 排版。" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ui:TextBox x:Name="SearchBox" Width="220" PlaceholderText="搜索标题或正文"
                            TextChanged="SearchBox_TextChanged" />
                <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- ============ 列表 + 详情 ============ -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Mt.Card.Flush}">
                <Grid>
                    <ListBox x:Name="NoticeList" Background="Transparent" BorderThickness="0"
                             Padding="0,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource AnnouncementListItem}"
                             SelectionChanged="NoticeList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 等级色条：用颜色区分紧急/重要/普通，不额外占文字 -->
                                    <Border Width="3" CornerRadius="2" Background="{Binding LevelBrush}"
                                            Margin="0,1,12,1" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding UnreadDotVisibility}" />
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="12" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding PinnedVisibility}" />
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Border Style="{StaticResource Mt.Pill}" Padding="6,1">
                                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource Mt.Pill.Text}"
                                                           Foreground="{Binding LevelBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Mt.Caption}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 加载中 -->
                    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="正在获取公告…" Style="{StaticResource Mt.Caption}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 空态 -->
                    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="News24" FontSize="24" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyText" Text="暂无公告" Style="{StaticResource Mt.Caption}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 失败态：把原因原样给出，并保留一次重试 -->
                    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" Margin="20"
                                Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="22" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Mt.Status.WarnBrush}" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource Mt.Caption}"
                                   TextAlignment="Center" Margin="0,10,0,0" />
                        <ui:Button Appearance="Secondary" Content="重试" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 详情：整块正文按 Markdown 渲染，可选中复制 -->
            <Border Grid.Column="2" Style="{StaticResource Mt.Card}" Padding="24,20,16,20">
                <Grid>
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="DetailLevelBadge" Style="{StaticResource Mt.Pill}">
                                <TextBlock x:Name="DetailLevelText" Text="公告"
                                           Style="{StaticResource Mt.Pill.Text}" />
                            </Border>
                            <Border x:Name="DetailPinnedBadge" Style="{StaticResource Mt.Pill.Accent}"
                                    Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="置顶" Style="{StaticResource Mt.Pill.Text}"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock x:Name="DetailMetaText" Style="{StaticResource Mt.Caption}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="DetailTitle" Grid.Row="1" Text="" FontSize="19" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,12,8,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Border Grid.Row="2" Style="{StaticResource Mt.Divider}" Margin="0,14,8,0" />

                        <FlowDocumentScrollViewer x:Name="DetailMarkdown" Grid.Row="3" Margin="0,12,8,0"
                                                  IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="Transparent" BorderThickness="0" Padding="0" />
                    </Grid>

                    <StackPanel x:Name="DetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="BookOpen24" FontSize="24" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="从左侧选择一条公告查看正文" Style="{StaticResource Mt.Caption}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
