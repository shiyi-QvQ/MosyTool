<Page x:Class="Mosytool.Views.BootPatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="脱机修补">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="脱机修补" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="boot / init_boot 离线修补：Magisk、KernelSU 系（GKI / LKM），或配合 AnyKernel3 制作 GKI"
                           FontSize="14" Margin="0,6,0,28"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- ============ 输入文件 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="输入文件" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="boot / init_boot 镜像" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BootImageBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseBoot_Click"/>
                        </Grid>

                        <TextBlock x:Name="ImageInfoText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="选择镜像后自动判断类型：boot.img 有内核可走 GKI；init_boot / vendor_boot 没有内核，只能走 LKM。"/>

                        <TextBlock x:Name="ApkLabel" FontSize="12" Margin="0,14,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="安装包（Magisk / KernelSU 系 APK，组件从它里面取；LKM 模式不需要）"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MagiskApkBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseMagisk_Click"/>
                        </Grid>

                        <TextBlock Text="输出目录" FontSize="12" Margin="0,14,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirBox" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="选择目录…" Click="BrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 修补选项 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="修补选项" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="修补方案" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="SchemeCombo" Width="250" Margin="12,0,0,0" SelectedIndex="0"
                                      SelectionChanged="SchemeCombo_SelectionChanged">
                                <ComboBoxItem Content="自动识别（按安装包 + 镜像）"/>
                                <ComboBoxItem Content="Magisk（注入 ramdisk）"/>
                                <ComboBoxItem Content="KernelSU 系 GKI（改内核，需安装包）"/>
                                <ComboBoxItem Content="KernelSU 系 LKM（注 .ko，免安装包）"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="SchemeHint" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="按安装包和镜像一起判断：Magisk 包注入 ramdisk；KernelSU / SukiSU 包有内核走 GKI 补丁，选的是 init_boot 就自动改用 LKM。"/>

                        <!-- LKM 参数：模块是预编译的，管理器家族和 KMI 必须与手机内核严格对应 -->
                        <StackPanel x:Name="LkmPanel" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="LKM 管理器" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="FamilyCombo" Width="130" Margin="12,0,0,0" SelectedIndex="1"
                                      SelectionChanged="FamilyCombo_SelectionChanged">
                                <ComboBoxItem Content="KernelSU"/>
                                <ComboBoxItem Content="SukiSU"/>
                                <ComboBoxItem Content="ReSukiSU"/>
                            </ComboBox>

                            <TextBlock Text="KMI" FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="KmiCombo" Width="150" Margin="12,0,0,0"/>
                            <ui:Button x:Name="DetectKmiButton" Appearance="Secondary" Margin="8,0,0,0"
                                       Content="读取设备" Click="DetectKmiButton_Click"/>
                            <TextBlock Text="（仅 LKM 用；与手机内核一致，如 android15-6.6）" FontSize="12" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="目标架构" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox x:Name="ArchCombo" Width="160" Margin="12,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="arm64-v8a"/>
                                <ComboBoxItem Content="armeabi-v7a"/>
                                <ComboBoxItem Content="x86_64"/>
                                <ComboBoxItem Content="x86"/>
                            </ComboBox>
                            <TextBlock Text="（选错会导致刷入后不开机，按设备 CPU 架构选；仅 Magisk 流程使用）" FontSize="12" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <CheckBox x:Name="ChkKeepVerity" Content="保留 verity（KEEPVERITY）" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkKeepForceEncrypt" Content="保留强制加密（KEEPFORCEENCRYPT）" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkPatchVbmeta" Content="修补 vbmeta 标志" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkRecoveryMode" Content="recovery 模式（老机型无 ramdisk）" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkLegacySar" Content="legacy SAR（改内核 want_initramfs）" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkPatchBinaries" Content="二进制补丁（dtb / 三星内核）" IsChecked="True" Margin="0,0,24,10"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 开始修补 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="开始修补" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="输出 patched-boot.img 到上面的输出目录，刷入对应分区即可。" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button x:Name="PatchButton" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Wrench24}" Content="开始脱机修补" Click="PatchButton_Click"/>
                            <ui:Button x:Name="CancelButton" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="取消" IsEnabled="False" Click="CancelButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 制作 GKI ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="制作 GKI 内核（AnyKernel3）" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="用 AnyKernel3 压缩包里的内核替换 boot 镜像的内核，打包成新 boot。和上面的「KernelSU 系内核补丁（GKI）」不是一回事。" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Ak3Box" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="选择 AK3…" Click="BrowseAk3_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox x:Name="ChkGkiDtb" Content="修补 dtb（去 verity/avb）" IsChecked="True" Margin="0,0,24,0"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <CheckBox x:Name="ChkGkiInitramfs" Content="改内核 want_initramfs"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <ui:Button x:Name="GkiButton" Appearance="Primary" Margin="0,16,0,0"
                                   Icon="{ui:SymbolIcon BoxMultiple24}" Content="制作 GKI 镜像" Click="GkiButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- ============ 日志 ============ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookOpen24" FontSize="18" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="日志" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="清空" Click="ClearLog_Click"/>
                        </Grid>

                        <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,8"
                                     Minimum="0" Maximum="100" IsIndeterminate="False"/>
                        <TextBlock x:Name="ProgressText" Text="等待操作…" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBox x:Name="LogBox" IsReadOnly="True" Height="220"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                 BorderThickness="0" Padding="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="等待操作…"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
