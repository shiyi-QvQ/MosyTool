<Page
      xmlns:controls="clr-namespace:Mosytool.Controls" x:Class="Mosytool.Views.UnlockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="设备解锁">

    <Page.Resources>
        <!-- 步骤列表的一项：序号圆点 + 文字 -->
        <DataTemplate x:Key="StepTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="18" Height="18" CornerRadius="9"
                        VerticalAlignment="Top" Margin="0,1,0,0"
                        Background="{DynamicResource Mt.Accent.SoftBrush}">
                    <TextBlock Text="{Binding Index}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="8,0,0,0"
                           FontSize="13" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Mt.PagePadding}"
                    MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Text="设备解锁" Style="{StaticResource Mt.PageTitle}" />

            <!-- ==================== 选择设备 ==================== -->
            <controls:SquircleBorder Style="{StaticResource Mt.Card}" Margin="0,16,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PhoneDesktop24" Style="{StaticResource Mt.SectionIcon}" />
                        <TextBlock Text="选择设备" Style="{StaticResource Mt.SectionTitle}" />
                    </StackPanel>

                    <ComboBox x:Name="DeviceCombo"
                              Margin="0,14,0,0" MinHeight="36" FontSize="13"
                              VerticalContentAlignment="Center"
                              SelectionChanged="DeviceCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontSize="13" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 选中机型后浮出的三个标签：芯片 / 型号 / 方案 -->
                    <StackPanel x:Name="DeviceMeta" Orientation="Horizontal"
                                Margin="0,12,0,0" Visibility="Collapsed">
                        <controls:SquircleBorder Style="{StaticResource Mt.Pill.Accent}" Margin="0,0,8,0">
                            <TextBlock x:Name="ChipText" Style="{StaticResource Mt.Pill.Text}" />
                        </controls:SquircleBorder>
                        <controls:SquircleBorder Style="{StaticResource Mt.Pill}" Margin="0,0,8,0">
                            <TextBlock x:Name="ModelText" Style="{StaticResource Mt.Pill.Text}" />
                        </controls:SquircleBorder>
                        <controls:SquircleBorder Style="{StaticResource Mt.Pill}">
                            <TextBlock x:Name="MethodText" Style="{StaticResource Mt.Pill.Text}" />
                        </controls:SquircleBorder>
                    </StackPanel>
                </StackPanel>
            </controls:SquircleBorder>

            <!-- ==================== 未选择时的空态 ==================== -->
            <controls:SquircleBorder x:Name="EmptyState" Style="{StaticResource Mt.Inset}" Padding="28" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="26"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                    <TextBlock Text="尚未选择设备" Margin="0,10,0,0" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </controls:SquircleBorder>

            <!-- ==================== 选中机型后的内容 ==================== -->
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">

                <!-- 镜像与 DA -->
                <controls:SquircleBorder Style="{StaticResource Mt.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Style="{StaticResource Mt.SectionIcon}" />
                            <TextBlock Text="镜像与 DA" Style="{StaticResource Mt.SectionTitle}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="解锁用 ocdt"
                                       Style="{StaticResource Mt.Label}" Margin="0,0,12,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="OcdtUnlockBox"
                                     IsReadOnly="True" MinHeight="32" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,8,8" />
                            <ui:Button Grid.Row="0" Grid.Column="2" Appearance="Secondary"
                                       Content="选择" Margin="0,0,0,8" Click="BrowseOcdtUnlock_Click" />

                            <TextBlock Grid.Row="1" Text="还原用 ocdt"
                                       Style="{StaticResource Mt.Label}" Margin="0,0,12,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="OcdtStockBox"
                                     IsReadOnly="True" MinHeight="32" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,8,8" />
                            <ui:Button Grid.Row="1" Grid.Column="2" Appearance="Secondary"
                                       Content="选择" Margin="0,0,0,8" Click="BrowseOcdtStock_Click" />

                            <TextBlock Grid.Row="2" Text="DA 目录"
                                       Style="{StaticResource Mt.Label}" Margin="0,0,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DaDirBox"
                                     IsReadOnly="True" MinHeight="32" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,8,0" />
                            <ui:Button Grid.Row="2" Grid.Column="2" Appearance="Secondary"
                                       Content="选择" Click="BrowseDaDir_Click" />
                        </Grid>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- 刷入前检查 -->
                <controls:SquircleBorder Style="{StaticResource Mt.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Style="{StaticResource Mt.SectionIcon}"
                                           Foreground="{DynamicResource Mt.Status.WarnBrush}" />
                            <TextBlock Text="刷入前检查" Style="{StaticResource Mt.SectionTitle}" />
                        </StackPanel>

                        <!-- 槽位：必须是 A 槽 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="当前槽位" Style="{StaticResource Mt.Label}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="SlotDot" Style="{StaticResource Mt.StatusDot}" Margin="0,0,8,0" />
                                <TextBlock x:Name="SlotText" Style="{StaticResource Mt.Label}" Text="未检测" />
                            </StackPanel>

                            <ui:Button Grid.Column="2" Appearance="Secondary"
                                       Content="检查槽位" Click="CheckSlot_Click" />
                        </Grid>

                        <TextBlock Style="{StaticResource Mt.Caption}" Margin="0,10,0,0"
                                   Text="必须是 A 槽位：B 槽位刷完 ocdt 有极大概率卡在开机无限重启。" />

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,16,0,0" />

                        <TextBlock Style="{StaticResource Mt.BodyMuted}" Margin="0,14,0,0"
                                   Text="关闭 Windows 安全中心实时防护、第三方杀毒与手机助手类程序，否则驱动会被拦截，写入中途掉线。" />

                        <CheckBox x:Name="ChkSafety" Margin="0,12,0,0" FontSize="13"
                                  Content="已完成上述准备" />
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- 执行 -->
                <controls:SquircleBorder Style="{StaticResource Mt.Card.Accent}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" Style="{StaticResource Mt.SectionIcon}" />
                            <TextBlock Text="执行" Style="{StaticResource Mt.SectionTitle}" />
                        </StackPanel>

                        <TextBlock x:Name="DeviceInfoText" Style="{StaticResource Mt.Label}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" Text="尚未读取设备" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button x:Name="ReadInfoButton" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="读取设备信息" Click="ReadInfo_Click" />
                            <ui:Button x:Name="UnlockButton" Appearance="Primary" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon LockClosed24}"
                                       Content="开始解锁" Click="Unlock_Click" />
                            <ui:Button x:Name="CancelButton" Appearance="Secondary" Margin="8,0,0,0"
                                       Content="取消" IsEnabled="False" Click="CancelButton_Click" />
                        </StackPanel>

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,16,0,0" />

                        <TextBlock Style="{StaticResource Mt.Caption}" Margin="0,12,0,0"
                                   Text="ocdt 写入并重启后，用下面两个按钮收尾：FastBoot 解锁，以及按需还原原厂 ocdt。" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button x:Name="FastbootUnlockButton" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Key24}"
                                       Content="进入 FastBoot 并解锁" Click="EnterFastbootUnlock_Click" />
                            <ui:Button x:Name="RestoreButton" Appearance="Secondary" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Content="还原 ocdt" Click="Restore_Click" />
                        </StackPanel>
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- 流程 -->
                <controls:SquircleBorder Style="{StaticResource Mt.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BookOpen24" Style="{StaticResource Mt.SectionIcon}" />
                            <TextBlock Text="流程" Style="{StaticResource Mt.SectionTitle}" />
                        </StackPanel>

                        <ItemsControl x:Name="StepsList" Margin="0,14,0,0"
                                      ItemTemplate="{StaticResource StepTemplate}" />
                    </StackPanel>
                </controls:SquircleBorder>

                <!-- 日志 -->
                <controls:SquircleBorder Style="{StaticResource Mt.Card.Tight}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="日志" Style="{StaticResource Mt.SectionTitle}" />
                            <ui:Button HorizontalAlignment="Right" Appearance="Secondary"
                                       Content="清空" Click="ClearLog_Click" />
                        </Grid>

                        <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,14,0,0"
                                     Minimum="0" Maximum="100" IsIndeterminate="False" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Mt.Caption}"
                                   Margin="0,8,0,0" Text="等待操作" />

                        <controls:SquircleBorder Style="{StaticResource Mt.Inset}" Margin="0,10,0,0" Padding="0">
                            <TextBox x:Name="LogBox" Height="190"
                                     FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                     FontSize="12" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0" Padding="12"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Text="等待操作…" />
                        </controls:SquircleBorder>
                    </StackPanel>
                </controls:SquircleBorder>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
