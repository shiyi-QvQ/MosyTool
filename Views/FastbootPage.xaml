<Page x:Class="Mosytool.Views.FastbootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Mosytool.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="Fastboot 工具">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource Mt.PagePadding}">
                <TextBlock Style="{StaticResource Mt.PageTitle}" Text="Fastboot 工具" />
                <TextBlock Style="{StaticResource Mt.PageSubtitle}" Text="检测设备、读取分区表并刷入镜像。" />

                <!-- ============ 设备状态 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="PhoneLaptop24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="设备状态" />
                                <!-- 状态点 + 一行短文案：这是全页唯一表达“当前能不能干活”的地方 -->
                                <Border x:Name="StateDot" Style="{StaticResource Mt.StatusDot}" Margin="14,0,0,0" />
                                <TextBlock x:Name="StateText" Text="未检测" Style="{StaticResource Mt.Label}"
                                           Margin="7,0,0,0" />
                            </StackPanel>

                            <ui:Button x:Name="DetectButton" Grid.Column="1" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Content="刷新设备"
                                       Click="DetectButton_Click" />
                        </Grid>

                        <Border Style="{StaticResource Mt.Divider}" Margin="0,16,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="设备名称" />
                            <TextBlock x:Name="ModelText" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="当前槽位" />
                            <TextBlock x:Name="SlotText" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="分区方案" />
                            <TextBlock x:Name="SlotSchemeText" Grid.Column="1" Text="-" Style="{StaticResource Mt.Body}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="槽位分布" VerticalAlignment="Top" />
                            <TextBlock x:Name="SlotStatsText" Grid.Column="1" Text="-" Style="{StaticResource Mt.BodyMuted}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 设备操作 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="ArrowDownload24" />
                            <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="设备操作" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button x:Name="LoadPartitionButton" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Content="读取分区"
                                       Click="LoadPartition_Click" />
                            <ui:Button x:Name="ExportPartitionButton" Appearance="Secondary" Margin="8,0,0,0"
                                       IsEnabled="False" Content="导出分区表" Click="ExportPartition_Click" />
                            <ui:Button x:Name="FlashButton" Appearance="Primary" Margin="8,0,0,0"
                                       IsEnabled="False" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Content="刷入分区" Click="FlashButton_Click" />
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="目标分区" />
                            <ComboBox x:Name="PartitionCombo" Grid.Column="1" IsEditable="True"
                                      StaysOpenOnEdit="True" IsTextSearchEnabled="True"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Mt.Label}" Text="镜像文件" />
                            <TextBox x:Name="ImagePathBox" Grid.Column="1" IsReadOnly="True" FontSize="13"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:Button Grid.Column="2" Appearance="Secondary" Margin="12,0,0,0"
                                       Content="浏览…" Click="BrowseImage_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 分区表 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="Box24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="分区表" />
                            </StackPanel>

                            <ui:Button x:Name="CopyPartitionButton" Grid.Column="1" Appearance="Secondary"
                                       Padding="10,4" Content="复制分区名" Click="CopyPartition_Click"
                                       IsEnabled="False"
                                       ToolTip="把选中行的分区名复制到剪贴板；没有选中时复制全部。" />
                        </Grid>

                        <TextBlock x:Name="PartitionCountText" Text="点击「读取分区」获取设备上的实际分区。"
                                   Style="{StaticResource Mt.Caption}" Margin="0,12,0,10" />

                        <DataGrid x:Name="PartitionGrid" Height="300" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" RowHeight="30"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" BorderThickness="0" Background="Transparent"
                                  GridLinesVisibility="Horizontal" FontSize="12.5"
                                  SelectionChanged="PartitionGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分区名" Binding="{Binding Name}"        Width="1.3*"/>
                                <DataGridTextColumn Header="槽位"   Binding="{Binding SlotDisplay}" Width="0.9*"/>
                                <DataGridTextColumn Header="双槽位" Binding="{Binding SlotInfo}"    Width="0.8*"/>
                                <DataGridTextColumn Header="大小"   Binding="{Binding SizeHuman}"   Width="0.9*"/>
                                <DataGridTextColumn Header="字节"   Binding="{Binding SizeHex}"     Width="1.1*"/>
                                <DataGridTextColumn Header="类型"   Binding="{Binding Type}"        Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <CheckBox x:Name="SlotFilterCheck" Content="只看 A/B 双槽位分区" Margin="0,12,0,0"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  Click="SlotFilter_Changed" />
                    </StackPanel>
                </Border>

                <!-- ============ 刷入日志 ============ -->
                <Border Style="{StaticResource Mt.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource Mt.SectionIcon}" Symbol="BookOpen24" />
                                <TextBlock Style="{StaticResource Mt.SectionTitle}" Text="刷入日志" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="清空" Click="ClearLog_Click" />
                        </Grid>

                        <!-- ctl:LogView：只读日志框，按日志等级着色（错误红 / 警告黄 / 成功绿 / 细节灰） -->
                        <ctl:LogView x:Name="LogBox" Height="220" Margin="0,16,0,0"
                                     FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource Mt.InsetFillBrush}"
                                     BorderThickness="0" Padding="12"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
