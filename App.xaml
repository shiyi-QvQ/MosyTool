<Application x:Class="Mosytool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>


            <Color x:Key="SystemAccentColor">#FF3B91D8</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3B91D8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF2983CC" />
            <SolidColorBrush x:Key="Mt.Accent.SoftBrush" Color="#1F3B91D8" />
            <SolidColorBrush x:Key="Mt.Accent.SoftStrokeBrush" Color="#3D3B91D8" />

            <LinearGradientBrush x:Key="Win12MicaBrush" StartPoint="0.787,0.09" EndPoint="0.213,0.91">
                <GradientStop Color="#FFF5F8FC" Offset="0" />
                <GradientStop Color="#FFD3DCE9" Offset="1" />
            </LinearGradientBrush>


            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="Mt.Corner.Card">12</CornerRadius>
            <CornerRadius x:Key="Mt.Corner.Control">8</CornerRadius>
            <CornerRadius x:Key="Mt.Corner.Pill">999</CornerRadius>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1F2C3E52" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF7C8794" />

            <SolidColorBrush x:Key="Mt.InsetFillBrush" Color="#B8E9EDF3" />
            <SolidColorBrush x:Key="Mt.InsetStrokeBrush" Color="#1A2C3E52" />

            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#D8E9EDF3" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF0F151C" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF4D575F" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF77808A" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFA4ACB4" />

            <SolidColorBrush x:Key="Mt.Status.IdleBrush" Color="#FF98A1AB" />
            <SolidColorBrush x:Key="Mt.Status.BusyBrush" Color="#FF3B91D8" />
            <SolidColorBrush x:Key="Mt.Status.OkBrush" Color="#FF2E9E6B" />
            <SolidColorBrush x:Key="Mt.Status.WarnBrush" Color="#FFCC8A2F" />
            <SolidColorBrush x:Key="Mt.Status.ErrorBrush" Color="#FFD1504E" />

            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#A6FFFFFF" />

            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#142C3E52" />

            <Style x:Key="Mt.PageTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <Style x:Key="Mt.PageSubtitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.SectionTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.SectionIcon" TargetType="{x:Type ui:SymbolIcon}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Body" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="Mt.BodyMuted" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Mt.Label" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Caption" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="Mt.Metric" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Mono" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Card" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Card}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="Mt.Card.Tight" TargetType="{x:Type Border}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Mt.Card.Flush" TargetType="{x:Type Border}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="Mt.Inset" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Mt.InsetFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Mt.InsetStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Control}" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="Mt.Card.Accent" TargetType="{x:Type Border}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Background" Value="{DynamicResource Mt.Accent.SoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Mt.Accent.SoftStrokeBrush}" />
            </Style>

            <Style x:Key="Mt.Pill" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Pill}" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Mt.Pill.Accent" TargetType="{x:Type Border}" BasedOn="{StaticResource Mt.Pill}">
                <Setter Property="Background" Value="{DynamicResource Mt.Accent.SoftBrush}" />
            </Style>

            <Style x:Key="Mt.Pill.Text" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Divider" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>

            <SolidColorBrush x:Key="Mt.TabItemHoverBrush" Color="#14000000" />

            <Style x:Key="Mt.TabItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid>
                                <Border x:Name="Bg" Background="Transparent"
                                        CornerRadius="{StaticResource Mt.Corner.Control}"
                                        Padding="13,7,13,9">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="Mark" Height="2.5" Width="18" CornerRadius="1.5"
                                        VerticalAlignment="Bottom" Background="Transparent" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource Mt.TabItemHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource Mt.Accent.SoftBrush}" />
                                    <Setter TargetName="Mark" Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.TabBar" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.TabIcon" TargetType="{x:Type ui:SymbolIcon}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Mt.TabsHost" TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.StatusDot" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource Mt.Status.IdleBrush}" />
            </Style>

            <Style x:Key="Mt.Meter" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="8" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource Mt.InsetFillBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Mt.InsetStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Mt.Corner.Pill}"
                                    ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="{StaticResource Mt.Corner.Pill}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.Meter.Value" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Log.Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Mt.Mono}">
                <Setter Property="LineHeight" Value="19" />
            </Style>

            <Thickness x:Key="Mt.PagePadding">28,24,28,28</Thickness>

            <SolidColorBrush x:Key="SlimScrollBarThumbFill" Color="#59000000" />
            <SolidColorBrush x:Key="SlimScrollBarThumbFillHover" Color="#8C000000" />
            <SolidColorBrush x:Key="SlimScrollBarThumbFillDrag" Color="#B3000000" />

            <Style x:Key="SlimScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="Bar" CornerRadius="3"
                                    Background="{DynamicResource SlimScrollBarThumbFill}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource SlimScrollBarThumbFillHover}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource SlimScrollBarThumbFillDrag}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                      Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollBarThumb}"
                                               Width="6" HorizontalAlignment="Center" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                      Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="12" />
                        <Setter Property="MinHeight" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" Orientation="Horizontal">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                              Command="ScrollBar.PageLeftCommand" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SlimScrollBarThumb}"
                                                       Height="6" VerticalAlignment="Center" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                              Command="ScrollBar.PageRightCommand" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
