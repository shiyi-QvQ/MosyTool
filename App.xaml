<Application x:Class="Mosytool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Mosytool.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>


            <Color x:Key="SystemAccentColor">#FF3B91D8</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3B91D8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF2983CC" />
            <SolidColorBrush x:Key="Mt.Accent.SoftBrush" Color="#1F3B91D8" />
            <SolidColorBrush x:Key="Mt.Accent.SoftStrokeBrush" Color="#3D3B91D8" />

            <LinearGradientBrush x:Key="Win12MicaBrush" StartPoint="0.787,0.09" EndPoint="0.213,0.91">
                <GradientStop Color="#FFF5F8FC" Offset="0" />
                <GradientStop Color="#FFD3DCE9" Offset="1" />
            </LinearGradientBrush>


            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
            <!-- SquircleBorder 的 CornerRadius 是 double（连续曲率的半径），
                 所以这三个令牌必须用 sys:Double，不能沿用 Border 的 CornerRadius 结构。 -->
            <sys:Double x:Key="Mt.Corner.Card">12</sys:Double>
            <sys:Double x:Key="Mt.Corner.Control">8</sys:Double>
            <sys:Double x:Key="Mt.Corner.Pill">999</sys:Double>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1F2C3E52" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF7C8794" />

            <SolidColorBrush x:Key="Mt.InsetFillBrush" Color="#B8E9EDF3" />
            <SolidColorBrush x:Key="Mt.InsetStrokeBrush" Color="#1A2C3E52" />

            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#D8E9EDF3" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF0F151C" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF4D575F" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF77808A" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FFA4ACB4" />

            <SolidColorBrush x:Key="Mt.Status.IdleBrush" Color="#FF98A1AB" />
            <SolidColorBrush x:Key="Mt.Status.BusyBrush" Color="#FF3B91D8" />
            <SolidColorBrush x:Key="Mt.Status.OkBrush" Color="#FF2E9E6B" />
            <SolidColorBrush x:Key="Mt.Status.WarnBrush" Color="#FFCC8A2F" />
            <SolidColorBrush x:Key="Mt.Status.ErrorBrush" Color="#FFD1504E" />

            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#A6FFFFFF" />

            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#142C3E52" />

            <!-- 自绘窗口：外框描边与标题栏按钮的悬停/按下底色 -->
            <SolidColorBrush x:Key="Mt.WindowStrokeBrush" Color="#2E2C3E52" />
            <SolidColorBrush x:Key="Mt.CaptionHoverBrush" Color="#0F1A2430" />
            <SolidColorBrush x:Key="Mt.CaptionPressedBrush" Color="#1F1A2430" />
            <SolidColorBrush x:Key="Mt.CaptionCloseHoverBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="Mt.CaptionClosePressedBrush" Color="#FFB32A1B" />

            <!-- 自绘按钮：底色 + 悬停/按下时叠加的一层半透明遮罩 -->
            <SolidColorBrush x:Key="Mt.Button.SecondaryBackgroundBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="Mt.Button.PrimaryForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Mt.Button.HoverOverlayBrush" Color="#12000000" />
            <SolidColorBrush x:Key="Mt.Button.PressedOverlayBrush" Color="#22000000" />

            <!-- 输入框：鼠标悬停时的描边色 -->
            <SolidColorBrush x:Key="Mt.Input.StrokeHoverBrush" Color="#3D2C3E52" />

            <!-- 弹窗遮罩：铺满宿主窗口内容区，压暗底下的页面 -->
            <SolidColorBrush x:Key="Mt.Overlay.DimBrush" Color="#59000000" />

            <Style x:Key="Mt.PageTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>

            <Style x:Key="Mt.PageSubtitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.SectionTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.SectionIcon" TargetType="{x:Type ui:SymbolIcon}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Body" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="Mt.BodyMuted" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Mt.Label" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Caption" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="Mt.Metric" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Mono" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Card" TargetType="{x:Type controls:SquircleBorder}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Card}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="Mt.Card.Tight" TargetType="{x:Type controls:SquircleBorder}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Mt.Card.Flush" TargetType="{x:Type controls:SquircleBorder}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="Mt.Inset" TargetType="{x:Type controls:SquircleBorder}">
                <Setter Property="Background" Value="{DynamicResource Mt.InsetFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Mt.InsetStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Control}" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="Mt.Card.Accent" TargetType="{x:Type controls:SquircleBorder}" BasedOn="{StaticResource Mt.Card}">
                <Setter Property="Background" Value="{DynamicResource Mt.Accent.SoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Mt.Accent.SoftStrokeBrush}" />
            </Style>

            <Style x:Key="Mt.Pill" TargetType="{x:Type controls:SquircleBorder}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource Mt.Corner.Pill}" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Mt.Pill.Accent" TargetType="{x:Type controls:SquircleBorder}" BasedOn="{StaticResource Mt.Pill}">
                <Setter Property="Background" Value="{DynamicResource Mt.Accent.SoftBrush}" />
            </Style>

            <Style x:Key="Mt.Pill.Text" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Mt.Divider" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>

            <SolidColorBrush x:Key="Mt.TabItemHoverBrush" Color="#14000000" />

            <Style x:Key="Mt.TabItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid>
                                <controls:SquircleBorder x:Name="Bg" Background="Transparent"
                                        CornerRadius="{StaticResource Mt.Corner.Control}"
                                        Padding="13,7,13,9">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </controls:SquircleBorder>

                                <Border x:Name="Mark" Height="2.5" Width="18" CornerRadius="1.5"
                                        VerticalAlignment="Bottom" Background="Transparent" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource Mt.TabItemHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource Mt.Accent.SoftBrush}" />
                                    <Setter TargetName="Mark" Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.TabBar" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.TabIcon" TargetType="{x:Type ui:SymbolIcon}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Mt.TabsHost" TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Mt.StatusDot" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource Mt.Status.IdleBrush}" />
            </Style>

            <Style x:Key="Mt.Meter" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="8" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource Mt.InsetFillBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <!-- 圆角要按实际高度给（轨道 8 → 4，轨道内减掉 1px 边框的填充条 6 → 3）。
                                 写成 999 这类超大值时，WPF 会按宽度把圆弧压扁，整条会渲染成两头尖的梭形。 -->
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Mt.InsetStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 各页面里没写 Style 的进度条统一走这套模板，避免落回系统默认的旧样式 -->
            <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Mt.Meter}" />

            <Style x:Key="Mt.Meter.Value" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Mt.Log.Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Mt.Mono}">
                <Setter Property="LineHeight" Value="19" />
            </Style>

            <Thickness x:Key="Mt.PagePadding">28,24,28,28</Thickness>

            <SolidColorBrush x:Key="SlimScrollBarThumbFill" Color="#59000000" />
            <SolidColorBrush x:Key="SlimScrollBarThumbFillHover" Color="#8C000000" />
            <SolidColorBrush x:Key="SlimScrollBarThumbFillDrag" Color="#B3000000" />

            <Style x:Key="SlimScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="Bar" CornerRadius="3"
                                    Background="{DynamicResource SlimScrollBarThumbFill}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource SlimScrollBarThumbFillHover}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bar" Property="Background"
                                            Value="{DynamicResource SlimScrollBarThumbFillDrag}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SlimScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                      Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollBarThumb}"
                                               Width="6" HorizontalAlignment="Center" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                      Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="12" />
                        <Setter Property="MinHeight" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" Orientation="Horizontal">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                              Command="ScrollBar.PageLeftCommand" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource SlimScrollBarThumb}"
                                                       Height="6" VerticalAlignment="Center" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource SlimScrollBarPageButton}"
                                                              Command="ScrollBar.PageRightCommand" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}" />

            <!-- ===================== 自绘输入框 =====================
                 外面那层壳换成 SquircleBorder（8px 连续曲率），
                 PART_ContentHost 保留原生 ScrollViewer，输入/选择/滚动行为不变。
                 悬停时叠一层很淡的遮罩并渐变淡入，避免颜色硬切。 -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Grid>
                                <controls:SquircleBorder x:Name="Shell"
                                                         CornerRadius="{StaticResource Mt.Corner.Control}"
                                                         Background="{TemplateBinding Background}"
                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                         BorderThickness="{TemplateBinding BorderThickness}" />

                                <controls:SquircleBorder x:Name="Hover"
                                                         CornerRadius="{StaticResource Mt.Corner.Control}"
                                                         Opacity="0" IsHitTestVisible="False"
                                                         Background="{DynamicResource Mt.Button.HoverOverlayBrush}" />

                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Shell" Property="BorderThickness" Value="1.5" />
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- WPF-UI 的 TextBox 是独立类型（有自己的默认样式），
                 隐式 TextBox 样式不会作用到它，所以单独写一份，多一个占位提示。 -->
            <Style TargetType="{x:Type ui:TextBox}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:TextBox}">
                            <Grid>
                                <controls:SquircleBorder x:Name="Shell"
                                                         CornerRadius="{StaticResource Mt.Corner.Control}"
                                                         Background="{TemplateBinding Background}"
                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                         BorderThickness="{TemplateBinding BorderThickness}" />

                                <controls:SquircleBorder x:Name="Hover"
                                                         CornerRadius="{StaticResource Mt.Corner.Control}"
                                                         Opacity="0" IsHitTestVisible="False"
                                                         Background="{DynamicResource Mt.Button.HoverOverlayBrush}" />

                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Margin="11,0"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Shell" Property="BorderBrush"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Shell" Property="BorderThickness" Value="1.5" />
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== 日志框 =====================
                 只读 RichTextBox（LogView）：外圈同样换成连续曲率，
                 和输入框、卡片保持同一套圆角语言。 -->
            <Style TargetType="{x:Type controls:LogView}">
                <Setter Property="Background" Value="{DynamicResource Mt.InsetFillBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:LogView}">
                            <Grid>
                                <controls:SquircleBorder CornerRadius="{StaticResource Mt.Corner.Control}"
                                                         Background="{TemplateBinding Background}" />

                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== 自绘列表项 =====================
                 公告等列表的每一行：外面那圈也换成连续曲率，
                 悬停/选中各叠一层，用透明度渐变过渡而不是硬切底色。 -->
            <Style x:Key="Mt.ListItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid>
                                <controls:SquircleBorder x:Name="Hover"
                                                         CornerRadius="10" Margin="4,0"
                                                         Opacity="0" IsHitTestVisible="False"
                                                         Background="{DynamicResource Mt.Button.HoverOverlayBrush}" />

                                <controls:SquircleBorder x:Name="Selected"
                                                         CornerRadius="10" Margin="4,0"
                                                         Opacity="0" IsHitTestVisible="False"
                                                         Background="{DynamicResource Mt.Accent.SoftBrush}"
                                                         BorderBrush="{DynamicResource Mt.Accent.SoftStrokeBrush}"
                                                         BorderThickness="1" />

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Hover"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Selected"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Selected"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== 自绘按钮 =====================
                 只保留 WPF-UI 按钮的外观语义（Appearance），视觉全部自绘：
                 外形是 8px 连续曲率，底色由 Appearance 决定，
                 悬停/按下靠叠一层半透明遮罩，深色浅色都不用各写一套状态色。 -->
            <Style TargetType="{x:Type ui:Button}">
                <Setter Property="Background" Value="{DynamicResource Mt.Button.SecondaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:Button}">
                            <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                                <controls:SquircleBorder x:Name="Surface" CornerRadius="8"
                                                         Background="{TemplateBinding Background}"
                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                         BorderThickness="{TemplateBinding BorderThickness}" />

                                <controls:SquircleBorder x:Name="Overlay" CornerRadius="8" Opacity="0"
                                                         IsHitTestVisible="False"
                                                         Background="{DynamicResource Mt.Button.HoverOverlayBrush}" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter x:Name="IconHost"
                                                      Content="{TemplateBinding Icon}"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="ContentHost"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="{x:Null}">
                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Overlay" Property="Background"
                                            Value="{DynamicResource Mt.Button.HoverOverlayBrush}" />
                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Overlay" Property="Background"
                                            Value="{DynamicResource Mt.Button.PressedOverlayBrush}" />
                                    <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                </Trigger>

                                <!-- 点击后按钮会拿到键盘焦点，默认的焦点描边是一圈很显眼的蓝框，
                                     和按下缩放叠在一起像两层反馈。这里不画描边，按下反馈只留缩放。 -->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Primary">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource Mt.Button.PrimaryForegroundBrush}" />
                    </Trigger>

                    <Trigger Property="Appearance" Value="Transparent">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===================== 自绘窗口 =====================
                 窗口本体由 WindowStyle=None + AllowsTransparency 撑起一块透明画布：
                 先画一层模糊的 squircle 当阴影，再画真正的外框（渐变背景 + 1px 描边），
                 内容放进外框里，跟随同一套连续曲率轮廓裁剪。
                 最大化时 MtWindow 会把 FrameMargin/FrameCornerRadius 归零，窗口贴合工作区。 -->
            <Style TargetType="{x:Type controls:MtWindow}">
                <Setter Property="WindowBackground" Value="{DynamicResource Win12MicaBrush}" />
                <Setter Property="WindowBorderBrush" Value="{DynamicResource Mt.WindowStrokeBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:MtWindow}">
                            <Grid Background="Transparent">
                                <controls:SquircleBorder Margin="{TemplateBinding FrameMargin}"
                                                         CornerRadius="{TemplateBinding FrameCornerRadius}"
                                                         Background="Black" Opacity="0.26">
                                    <controls:SquircleBorder.Effect>
                                        <BlurEffect Radius="18" />
                                    </controls:SquircleBorder.Effect>
                                </controls:SquircleBorder>

                                <controls:SquircleBorder Margin="{TemplateBinding FrameMargin}"
                                                         CornerRadius="{TemplateBinding FrameCornerRadius}"
                                                         Background="{TemplateBinding WindowBackground}"
                                                         BorderBrush="{TemplateBinding WindowBorderBrush}"
                                                         BorderThickness="1">
                                    <!-- ContentHost 是真正的窗口内容，弹窗打开时对它加模糊；
                                         OverlayHost 是遮罩层，弹窗卡片挂在它上面，因此不会被糊掉。 -->
                                    <Grid>
                                        <ContentPresenter x:Name="ContentHost" />
                                        <Grid x:Name="OverlayHost" Visibility="Collapsed" />
                                    </Grid>
                                </controls:SquircleBorder>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
