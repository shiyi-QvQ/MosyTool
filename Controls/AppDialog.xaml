<UserControl x:Class="Mosytool.Controls.AppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Mosytool.Controls"
             FontFamily="Microsoft YaHei UI">

    <!-- 卡片本体：遮罩、居中与入场/退场动效都由 ModalOverlay 负责 -->
    <controls:SquircleBorder x:Name="Card"
            Width="460"
            CornerRadius="14"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <controls:SquircleBorder.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.34" Color="Black"/>
        </controls:SquircleBorder.Effect>

        <Grid Margin="26,24,26,22" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconHost" Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <ui:SymbolIcon x:Name="IconGlyph" Symbol="Info24" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="提示" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </ScrollViewer>

            <StackPanel x:Name="ButtonHost" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,22,0,0"/>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
