<UserControl x:Class="Mosytool.Controls.AnnouncementCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Mosytool.Controls"
             FontFamily="Microsoft YaHei UI">

    <controls:SquircleBorder x:Name="Card"
            Width="560"
            CornerRadius="14"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <controls:SquircleBorder.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.34" Color="Black"/>
        </controls:SquircleBorder.Effect>

        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Alert24" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="公告" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <ui:Button x:Name="CloseButton" Grid.Column="2" Appearance="Transparent"
                           Width="32" Height="32" Padding="0"
                           VerticalAlignment="Center"
                           ToolTip="关闭" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
                </ui:Button>
            </Grid>

            <!-- 元信息 + 正文 -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <controls:SquircleBorder x:Name="LevelBadge" CornerRadius="6"
                                             Padding="8,2" VerticalAlignment="Center"
                                             Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="LevelText" Text="通知" FontSize="11" Foreground="White"/>
                    </controls:SquircleBorder>

                    <controls:SquircleBorder x:Name="PinnedBadge" CornerRadius="6" Margin="8,0,0,0"
                                             Padding="8,2" VerticalAlignment="Center"
                                             Background="{DynamicResource Mt.Accent.SoftBrush}">
                        <TextBlock Text="置顶" FontSize="11"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </controls:SquircleBorder>

                    <TextBlock x:Name="DateText" FontSize="11.5" VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <FlowDocumentScrollViewer x:Name="ContentMarkdown"
                                          IsToolBarVisible="False"
                                          MaxHeight="400"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <ui:Button x:Name="MuteButton" Content="不再提醒" Appearance="Secondary"
                           MinWidth="96" Height="34" Margin="0,0,10,0" Click="Mute_Click"/>
                <ui:Button x:Name="ConfirmButton" Content="我知道了" Appearance="Primary"
                           MinWidth="96" Height="34" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
