<controls:MtWindow x:Class="Mosytool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Mosytool.Controls"
        xmlns:views="clr-namespace:Mosytool.Views"
        mc:Ignorable="d"
        Title="MosyTool"
        Width="1180" Height="740"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI">

    <controls:MtWindow.Resources>
        <Style TargetType="{x:Type ui:NavigationViewItem}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </controls:MtWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0" Title="MosyTool" Icon="Fluent24"/>

        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsPaneOpen="True"
                           OpenPaneLength="216">

            <ui:NavigationView.PaneHeader>
                <Grid Margin="14,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Fluent24" FontSize="18"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="MosyTool" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" x:Name="SidebarVersion" Text="1.1.0.2"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavHome"
                                       Content="首页"
                                       Icon="{ui:SymbolIcon Home24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:HomePage}"/>
                <ui:NavigationViewItem x:Name="NavAnnouncement"
                                       Content="公告"
                                       Icon="{ui:SymbolIcon News24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:AnnouncementPage}"/>
                <ui:NavigationViewItem x:Name="NavFastboot"
                                       Content="Fastboot 工具"
                                       Icon="{ui:SymbolIcon Flash24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:FastbootPage}"/>

                <ui:NavigationViewItem x:Name="NavXiaomiFlash"
                                       Content="小米官方线刷"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:XiaomiFlashPage}"/>

                <ui:NavigationViewItem x:Name="NavAdb"
                                       Content="ADB 工具"
                                       Icon="{ui:SymbolIcon PhoneDesktop24}"
                                       IsExpanded="False">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem x:Name="NavAdbFiles"
                                               Content="文件推送"
                                               Tag="files"
                                               Icon="{ui:SymbolIcon Document24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:AdbPage}"
                                               PreviewMouseLeftButtonUp="NavAdbFeature_Click"/>
                        <ui:NavigationViewItem x:Name="NavAdbMirror"
                                               Content="投屏"
                                               Tag="mirror"
                                               Icon="{ui:SymbolIcon Cast24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:AdbPage}"
                                               PreviewMouseLeftButtonUp="NavAdbFeature_Click"/>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="NavAndroidGeneral"
                                       Content="安卓通用"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:AndroidGeneralPage}"/>

                <ui:NavigationViewItem x:Name="NavMtk"
                                       Content="MTK 工具"
                                       Icon="{ui:SymbolIcon Phone24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:MtkPage}"/>
                <ui:NavigationViewItem x:Name="NavEdl"
                                       Content="高通 EDL 工具"
                                       Icon="{ui:SymbolIcon Wrench24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:EdlPage}"/>
                <ui:NavigationViewItem x:Name="NavSuper"
                                       Content="super 工具"
                                       Icon="{ui:SymbolIcon BoxMultiple24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:SuperPage}"/>

                <ui:NavigationViewItem x:Name="NavMoreTools"
                                       Content="更多工具"
                                       Icon="{ui:SymbolIcon Rocket24}"
                                       IsExpanded="False">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem x:Name="NavPayload"
                                               Content="Payload 解包"
                                               Icon="{ui:SymbolIcon Box24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:PayloadPage}"/>
                        <ui:NavigationViewItem x:Name="NavOfp"
                                               Content="OFP 解包"
                                               Icon="{ui:SymbolIcon Archive24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:OfpPage}"/>
                        <ui:NavigationViewItem x:Name="NavBootPatch"
                                               Content="脱机修补"
                                               Icon="{ui:SymbolIcon Wrench24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:BootPatchPage}"/>
                        <ui:NavigationViewItem x:Name="NavUnlock"
                                               Content="设备解锁"
                                               Icon="{ui:SymbolIcon LockClosed24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:UnlockPage}"/>
                        <ui:NavigationViewItem x:Name="NavBattery"
                                               Content="电池健康"
                                               Icon="{ui:SymbolIcon BatteryCharge24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:BatteryPage}"/>
                        <ui:NavigationViewItem x:Name="NavRom"
                                               Content="官方 ROM 包"
                                               Icon="{ui:SymbolIcon Archive24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:RomPage}"/>
                        <ui:NavigationViewItem x:Name="NavDriver"
                                               Content="端口驱动"
                                               Icon="{ui:SymbolIcon UsbPlug24}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type views:DriverPage}"/>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavAbout"
                                       Content="关于"
                                       Icon="{ui:SymbolIcon Info24}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type views:AboutPage}"/>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <Grid Margin="15,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备连接即用" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="7,2"
                               ToolTip="检查更新" Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="CheckUpdate_Click" />
                </Grid>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
    </Grid>

</controls:MtWindow>
